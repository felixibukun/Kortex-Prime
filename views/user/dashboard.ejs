          <p class="text-xs text-slate-400">Follow expert traders</p>
        </a>
        <a href="/packages" class="bg-gradient-to-br from-slate-800 to-slate-900 rounded-xl p-4 border border-slate-700 hover-lift group">
          <div class="h-12 w-12 rounded-lg bg-amber-500/10 flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-400"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>
          </div>
          <h4 class="font-semibold text-white mb-1">Packages</h4>
          <p class="text-xs text-slate-400">Upgrade your account</p>
        </a>
        <a href="/package-history" class="bg-gradient-to-br from-slate-800 to-slate-900 rounded-xl p-4 border border-slate-700 hover-lift group">
          <div class="h-12 w-12 rounded-lg bg-cyan-500/10 flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-cyan-400"><path d="M21 8a2 2 0 0 0-1-1.73L13 2.27a2 2 0 0 0-2 0L4 6.27A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path><path d="M3.3 7 12 12l8.7-5"></path><path d="M12 22V12"></path></svg>
          </div>
          <h4 class="font-semibold text-white mb-1">Package History</h4>
          <p class="text-xs text-slate-400">Review subscriptions</p>
        </a>
        <a href="/pl-record" class="bg-gradient-to-br from-slate-800 to-slate-900 rounded-xl p-4 border border-slate-700 hover-lift group">
          <div class="h-12 w-12 rounded-lg bg-rose-500/10 flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-rose-400"><path d="M3 3v18h18"></path><path d="m19 9-5 5-4-4-3 3"></path></svg>
          </div>
          <h4 class="font-semibold text-white mb-1">P/L Record</h4>
          <p class="text-xs text-slate-400">Track gains and losses</p>
        </a>
        <a href="/transactions-history" class="bg-gradient-to-br from-slate-800 to-slate-900 rounded-xl p-4 border border-slate-700 hover-lift group">
          <div class="h-12 w-12 rounded-lg bg-indigo-500/10 flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-400"><path d="M3 12a9 9 0 1 0 3-6.7"></path><path d="M3 3v6h6"></path><path d="M12 7v5l3 2"></path></svg>
          </div>
          <h4 class="font-semibold text-white mb-1">Funding History</h4>
          <p class="text-xs text-slate-400">Deposits and withdrawals</p>
        </a>
        <a href="/support" class="bg-gradient-to-br from-slate-800 to-slate-900 rounded-xl p-4 border border-slate-700 hover-lift group">
          <div class="h-12 w-12 rounded-lg bg-emerald-500/10 flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-400"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
          </div>
          <h4 class="font-semibold text-white mb-1">24/7 Support</h4>
          <p class="text-xs text-slate-400">Get help anytime</p>
        </a>
      </div>

    </div>
  </main>

  <footer class="mt-8 py-6 border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="text-sm text-slate-500">&copy; <%= new Date().getFullYear() %> Kortex Prime. All rights reserved.</div>
        <div class="flex items-center gap-6 text-sm text-slate-500">
          <a href="/support" class="hover:text-slate-300 transition-colors">Support</a>
          <a href="/account" class="hover:text-slate-300 transition-colors">Privacy Policy</a>
          <a href="/account" class="hover:text-slate-300 transition-colors">Terms of Service</a>
        </div>
      </div>
      <div class="text-center text-xs text-slate-600 mt-4">Trading involves risk. Past performance is not indicative of future results.</div>
    </div>
  </footer>
</div>

