<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Account Settings | Kortex Prime</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
  <link rel="stylesheet" href="/css/premium-ui.css">

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace']
          },
          colors: {
            ink: '#050816',
            panel: '#0b1224',
            line: 'rgba(148, 163, 184, 0.18)',
            primary: {
              400: '#38bdf8',
              500: '#0ea5e9',
              600: '#2563eb'
            }
          }
        }
      }
    }
  </script>

  <style>
    html { scroll-behavior: smooth; }
    body {
      background:
        radial-gradient(circle at 12% 6%, rgba(14, 165, 233, 0.18), transparent 28%),
        radial-gradient(circle at 86% 12%, rgba(99, 102, 241, 0.16), transparent 30%),
        linear-gradient(135deg, #020617 0%, #071224 48%, #090d1d 100%);
      min-height: 100vh;
    }
    .premium-shell {
      background: rgba(11, 18, 36, 0.74);
      border: 1px solid rgba(148, 163, 184, 0.16);
      box-shadow: 0 24px 80px rgba(0, 0, 0, 0.32);
      backdrop-filter: blur(22px);
      -webkit-backdrop-filter: blur(22px);
    }
    .soft-panel {
      background: linear-gradient(180deg, rgba(15, 23, 42, 0.78), rgba(15, 23, 42, 0.54));
      border: 1px solid rgba(148, 163, 184, 0.14);
    }
    .account-input {
      width: 100%;
      border-radius: 16px;
      border: 1px solid rgba(148, 163, 184, 0.22);
      background: rgba(2, 6, 23, 0.62);
      color: #f8fafc;
      padding: 0.9rem 1rem;
      font-size: 0.9rem;
      outline: none;
      transition: border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
    }
    .account-input:focus {
      border-color: rgba(56, 189, 248, 0.68);
      background: rgba(2, 6, 23, 0.82);
      box-shadow: 0 0 0 4px rgba(14, 165, 233, 0.12);
    }
    select.account-input {
      cursor: pointer;
    }
    option {
      background: #0f172a;
      color: #fff;
    }
    input:-webkit-autofill,
    input:-webkit-autofill:hover,
    input:-webkit-autofill:focus {
      -webkit-text-fill-color: #fff;
      box-shadow: 0 0 0 1000px #020617 inset;
    }
  </style>
</head>

<body class="font-sans text-white">
  <%
    const displayName = user.name || user.username || 'Account Holder';
    const initials = displayName.slice(0, 1).toUpperCase();
    const kycRaw = String(user.kycStatus || '').toLowerCase();
    const isVerified = kycRaw === 'verified';
    const isRejected = kycRaw === 'rejected';
  %>

  <header class="sticky top-0 z-40 border-b border-white/10 bg-slate-950/70 backdrop-blur-2xl">
    <div class="mx-auto flex h-20 w-full max-w-7xl items-center justify-between px-4 sm:px-6">
      <div class="flex items-center gap-4">
        <button onclick="history.back()" class="flex h-11 w-11 items-center justify-center rounded-2xl border border-white/10 bg-white/5 text-slate-200 transition hover:border-cyan-400/40 hover:bg-cyan-400/10 hover:text-white" aria-label="Go back">
          <i data-lucide="arrow-left" class="h-5 w-5"></i>
        </button>
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-cyan-300">Account</p>
          <h1 class="mt-1 text-xl font-black tracking-tight text-white sm:text-2xl">Profile and settings</h1>
        </div>
      </div>

      <a href="/dashboard" class="inline-flex items-center gap-2 rounded-2xl border border-white/10 bg-white/5 px-4 py-2.5 text-sm font-bold text-slate-200 transition hover:border-cyan-400/40 hover:bg-cyan-400/10 hover:text-white">
        <i data-lucide="layout-dashboard" class="h-4 w-4"></i>
        <span class="hidden sm:inline">Back to dashboard</span>
      </a>
    </div>
  </header>

  <main class="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 lg:py-10">
    <section class="mb-6 premium-shell rounded-[28px] p-6 sm:p-8">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="inline-flex items-center gap-2 rounded-full border border-cyan-400/20 bg-cyan-400/10 px-3 py-1 text-xs font-bold uppercase tracking-[0.16em] text-cyan-300">
            <i data-lucide="shield-check" class="h-3.5 w-3.5"></i>
            Secure profile
          </p>
          <h2 class="mt-4 max-w-3xl text-3xl font-black tracking-tight text-white sm:text-4xl">
            Manage identity, contact details, and account access.
          </h2>
          <p class="mt-3 max-w-2xl text-sm leading-6 text-slate-400">
            Keep your personal information current so account notices, funding updates, and security messages reach you.
          </p>
        </div>

        <div class="grid grid-cols-2 gap-3 sm:min-w-[360px]">
          <div class="soft-panel rounded-2xl p-4">
            <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-slate-500">Total deposit</p>
            <p class="mt-2 font-mono text-lg font-black text-emerald-300">$<%= Number(user.deposit || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></p>
          </div>
          <div class="soft-panel rounded-2xl p-4">
            <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-slate-500">Balance</p>
            <p class="mt-2 font-mono text-lg font-black text-cyan-300">$<%= Number(user.balance || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></p>
          </div>
        </div>
      </div>
    </section>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-[380px_1fr]">
      <aside class="premium-shell rounded-[28px] p-6">
        <div class="flex flex-col items-center text-center">
          <div class="relative">
            <div class="flex h-24 w-24 items-center justify-center rounded-[28px] border border-cyan-400/25 bg-cyan-400/10 text-3xl font-black text-white shadow-2xl shadow-cyan-950/30">
              <%= initials %>
            </div>
            <span class="absolute -bottom-2 -right-2 flex h-9 w-9 items-center justify-center rounded-2xl border border-emerald-400/25 bg-emerald-400/15 text-emerald-300">
              <i data-lucide="user-round-check" class="h-4 w-4"></i>
            </span>
          </div>

          <h2 class="mt-6 text-xl font-black text-white"><%= displayName %></h2>
          <p class="mt-1 text-sm text-slate-400">@<%= user.username || 'username' %></p>

          <div class="mt-6 grid w-full grid-cols-1 gap-3">
            <div class="soft-panel rounded-2xl p-4 text-left">
              <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-slate-500">Email</p>
              <p class="mt-2 break-all text-sm font-semibold text-slate-100"><%= user.email || 'Not set' %></p>
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div class="soft-panel rounded-2xl p-4 text-left">
                <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-slate-500">Account</p>
                <p class="mt-2 inline-flex items-center gap-1.5 text-sm font-bold text-emerald-300">
                  <span class="h-2 w-2 rounded-full bg-emerald-300"></span>
                  Standard
                </p>
              </div>
              <div class="soft-panel rounded-2xl p-4 text-left">
                <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-slate-500">KYC</p>
                <% if (isVerified) { %>
                  <p class="mt-2 text-sm font-bold text-emerald-300">Verified</p>
                <% } else if (isRejected) { %>
                  <p class="mt-2 text-sm font-bold text-red-300">Rejected</p>
                <% } else { %>
                  <p class="mt-2 text-sm font-bold text-amber-300">Not verified</p>
                <% } %>
              </div>
            </div>
          </div>

          <div class="mt-6 w-full rounded-2xl border border-cyan-400/15 bg-cyan-400/10 p-4 text-left">
            <div class="flex gap-3">
              <i data-lucide="info" class="mt-0.5 h-4 w-4 flex-shrink-0 text-cyan-300"></i>
              <p class="text-xs leading-5 text-slate-300">
                Changes apply instantly after saving. Leave the password field blank to keep your current password.
              </p>
            </div>
          </div>
        </div>
      </aside>

      <section class="premium-shell rounded-[28px] p-6 sm:p-8">
        <div class="mb-7 flex flex-col gap-3 border-b border-white/10 pb-6 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.18em] text-cyan-300">Profile details</p>
            <h2 class="mt-2 text-2xl font-black text-white">Edit account information</h2>
          </div>
          <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-bold text-slate-300">
            <i data-lucide="lock-keyhole" class="h-3.5 w-3.5 text-cyan-300"></i>
            Encrypted update
          </div>
        </div>

        <form action="/account/update" method="POST" class="space-y-6">
          <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
            <div>
              <label class="mb-2 block text-sm font-bold text-slate-300">Full name</label>
              <input type="text" name="name" value="<%= user.name || '' %>" class="account-input" autocomplete="name">
            </div>
            <div>
              <label class="mb-2 block text-sm font-bold text-slate-300">Username</label>
              <input type="text" name="username" value="<%= user.username || '' %>" class="account-input" autocomplete="username">
            </div>
          </div>

          <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
            <div>
              <label class="mb-2 block text-sm font-bold text-slate-300">Email address</label>
              <input type="email" name="email" value="<%= user.email || '' %>" class="account-input" autocomplete="email">
              <p class="mt-2 text-xs leading-5 text-slate-500">Used for account activity, profile, and funding updates.</p>
            </div>
            <div>
              <label class="mb-2 block text-sm font-bold text-slate-300">Phone number</label>
              <input type="text" name="phone" value="<%= user.phone || '' %>" class="account-input" autocomplete="tel">
            </div>
          </div>

          <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
            <div>
              <label class="mb-2 block text-sm font-bold text-slate-300">Country</label>
              <select id="country" name="country" data-current="<%= user.country || '' %>" class="account-input">
                <option value="">Select country</option>
              </select>
            </div>
            <div>
              <label class="mb-2 block text-sm font-bold text-slate-300">Time zone</label>
              <select id="timezone" name="timezone" data-current="<%= user.timezone || '' %>" class="account-input">
                <option value="">Select time zone</option>
              </select>
            </div>
          </div>

          <div>
            <label class="mb-2 block text-sm font-bold text-slate-300">New password</label>
            <div class="relative">
              <input id="passwordInput" type="password" name="password" placeholder="Leave blank to keep current password" class="account-input pr-12" autocomplete="new-password">
              <button type="button" id="togglePassword" class="absolute right-3 top-1/2 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-xl text-slate-400 transition hover:bg-white/5 hover:text-white" aria-label="Toggle password visibility">
                <i data-lucide="eye" class="h-4 w-4"></i>
              </button>
            </div>
          </div>

          <div class="flex flex-col-reverse gap-3 border-t border-white/10 pt-6 sm:flex-row sm:justify-end">
            <a href="/dashboard" class="inline-flex items-center justify-center rounded-2xl border border-white/10 bg-white/5 px-5 py-3 text-sm font-bold text-slate-200 transition hover:bg-white/10 hover:text-white">
              Cancel
            </a>
            <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-cyan-500 to-blue-600 px-6 py-3 text-sm font-black text-white shadow-lg shadow-blue-950/30 transition hover:from-cyan-400 hover:to-blue-500">
              <i data-lucide="save" class="h-4 w-4"></i>
              Save changes
            </button>
          </div>
        </form>
      </section>
    </div>
  </main>

  <script>
    const isoCountries = ['AF','AX','AL','DZ','AS','AD','AO','AI','AQ','AG','AR','AM','AW','AU','AT','AZ','BS','BH','BD','BB','BY','BE','BZ','BJ','BM','BT','BO','BQ','BA','BW','BV','BR','IO','BN','BG','BF','BI','CV','KH','CM','CA','KY','CF','TD','CL','CN','CX','CC','CO','KM','CG','CD','CK','CR','CI','HR','CU','CW','CY','CZ','DK','DJ','DM','DO','EC','EG','SV','GQ','ER','EE','SZ','ET','FK','FO','FJ','FI','FR','GF','PF','TF','GA','GM','GE','DE','GH','GI','GR','GL','GD','GP','GU','GT','GG','GN','GW','GY','HT','HM','VA','HN','HK','HU','IS','IN','ID','IR','IQ','IE','IM','IL','IT','JM','JP','JE','JO','KZ','KE','KI','KP','KR','KW','KG','LA','LV','LB','LS','LR','LY','LI','LT','LU','MO','MG','MW','MY','MV','ML','MT','MH','MQ','MR','MU','YT','MX','FM','MD','MC','MN','ME','MS','MA','MZ','MM','NA','NR','NP','NL','NC','NZ','NI','NE','NG','NU','NF','MK','MP','NO','OM','PK','PW','PS','PA','PG','PY','PE','PH','PN','PL','PT','PR','QA','RE','RO','RU','RW','BL','SH','KN','LC','MF','PM','VC','WS','SM','ST','SA','SN','RS','SC','SL','SG','SX','SK','SI','SB','SO','ZA','GS','SS','ES','LK','SD','SR','SJ','SE','CH','SY','TW','TJ','TZ','TH','TL','TG','TK','TO','TT','TN','TR','TM','TC','TV','UG','UA','AE','GB','US','UM','UY','UZ','VU','VE','VN','VG','VI','WF','EH','YE','ZM','ZW'];

    function populateAccountCountry() {
      const country = document.getElementById('country');
      if (!country) return;
      const current = country.dataset.current || '';
      const names = typeof Intl !== 'undefined' && Intl.DisplayNames ? new Intl.DisplayNames(['en'], { type: 'region' }) : null;
      isoCountries
        .map(code => ({ code, name: names ? names.of(code) : code }))
        .filter(item => item.name)
        .sort((a, b) => a.name.localeCompare(b.name))
        .forEach(item => {
          const option = document.createElement('option');
          option.value = item.code;
          option.textContent = item.name;
          country.appendChild(option);
        });
      country.value = current;
    }

    function populateAccountTimezone() {
      const timezone = document.getElementById('timezone');
      if (!timezone) return;
      const current = timezone.dataset.current || Intl.DateTimeFormat().resolvedOptions().timeZone || '';
      const zones = Intl.supportedValuesOf ? Intl.supportedValuesOf('timeZone') : [];
      zones.forEach(zone => {
        const option = document.createElement('option');
        option.value = zone;
        option.textContent = zone.replace(/_/g, ' ');
        timezone.appendChild(option);
      });
      timezone.value = current;
    }

    populateAccountCountry();
    populateAccountTimezone();

    const togglePassword = document.getElementById('togglePassword');
    const passwordInput = document.getElementById('passwordInput');
    if (togglePassword && passwordInput) {
      togglePassword.addEventListener('click', () => {
        passwordInput.type = passwordInput.type === 'password' ? 'text' : 'password';
        togglePassword.innerHTML = passwordInput.type === 'password'
          ? '<i data-lucide="eye" class="h-4 w-4"></i>'
          : '<i data-lucide="eye-off" class="h-4 w-4"></i>';
        if (typeof lucide !== 'undefined') lucide.createIcons();
      });
    }

    if (typeof lucide !== 'undefined') lucide.createIcons();
  </script>

  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <% if (toast) { %>
    <script>
      Swal.fire({
        icon: '<%= toast.type %>',
        title: '<%= toast.message %>',
        toast: true,
        position: 'top-end',
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true,
        background: '#0f172a',
        color: '#ffffff',
        customClass: {
          popup: 'rounded-2xl border border-white/10',
          title: 'text-sm font-semibold'
        }
      })
    </script>
  <% } %>

  <%- include('mobile-downbar') %>
</body>
</html>
