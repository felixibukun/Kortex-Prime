<!DOCTYPE html> <html lang="en" class="dark"> <head> <meta charset="UTF-8"> <meta name="viewport" content="width=device-width, initial-scale=1"> <title>Account</title> <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"> <script src="https://cdn.tailwindcss.com"></script> <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script> <script> tailwind.config = { darkMode: 'class', theme: { extend: { colors: { primary: { 600: '#4F46E5' } }, fontFamily: { sans: ['Inter', 'sans-serif'] } } } } </script> <link rel="stylesheet" href="/css/premium-ui.css">
<style>
  input, select, textarea {
    color: #fff !important;
    caret-color: #fff;
  }

  option {
    background: #0f172a;
    color: #fff;
  }

  input:-webkit-autofill,
  input:-webkit-autofill:hover,
  input:-webkit-autofill:focus {
    -webkit-text-fill-color: #fff;
    box-shadow: 0 0 0 1000px #020617 inset;
  }
</style>
</head> <body class="bg-slate-950 text-white font-sans"> <header class="h-16 border-b border-slate-800 bg-slate-950/80 backdrop-blur-xl flex items-center"> <div class="w-full max-w-6xl mx-auto px-4 flex items-center justify-between"> <div class="flex items-center gap-3"> <button onclick="history.back()" class="h-8 w-8 rounded-xl bg-slate-900 border border-slate-700 flex items-center justify-center"> <i data-lucide="arrow-left" class="w-4 h-4"></i> </button> <div> <p class="text-xs text-slate-400">Account</p> <p class="text-sm font-semibold text-slate-100">Profile and settings</p> </div> </div>
  <a href="/dashboard" class="text-xs text-slate-300 hover:text-white">
    Back to dashboard
  </a>
</div>

</header> <main class="max-w-6xl mx-auto px-4 py-8 space-y-6">
<div class="grid grid-cols-1 md:grid-cols-3 gap-6">

  <!-- PROFILE SUMMARY -->
  <section class="md:col-span-1 bg-slate-900/80 border border-slate-800 rounded-2xl p-6 shadow-xl">
    <div class="flex flex-col items-center text-center gap-3">

      <div class="h-16 w-16 rounded-full bg-primary-600/10 border border-primary-600/40 flex items-center justify-center text-lg font-semibold">
        <%= (user.name || user.username || '?').slice(0,1).toUpperCase() %>
      </div>

      <div>
        <p class="text-sm font-semibold text-slate-100">
          <%= user.name || user.username %>
        </p>
        <p class="text-xs text-slate-400 mt-0.5">
          <%= user.username %>
        </p>
      </div>

      <div class="w-full mt-4 space-y-3 text-xs text-left">

        <div class="flex items-center justify-between">
          <span class="text-slate-400">Email</span>
          <span class="text-slate-100">
            <%= user.email || 'Not set' %>
          </span>
        </div>

        <div class="flex items-center justify-between">
          <span class="text-slate-400">Account type</span>
          <span class="inline-flex items-center gap-1 text-emerald-400 font-medium">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
            Standard
          </span>
        </div>

        <div class="flex items-center justify-between">
          <span class="text-slate-400">KYC status</span>
          <% if (user.kycStatus === 'verified') { %>
            <span class="text-emerald-400 font-medium">Verified</span>
          <% } else if (user.kycStatus === 'rejected') { %>
            <span class="text-red-400 font-medium">Rejected</span>
          <% } else { %>
            <span class="text-amber-400 font-medium">Not verified</span>
          <% } %>
        </div>

      </div>

      <p class="mt-4 text-[11px] text-slate-500">
        Update your personal information on the right panel and save changes.
      </p>
    </div>
  </section>

  <!-- EDIT FORM -->
  <section class="md:col-span-2 bg-slate-900/80 border border-slate-800 rounded-2xl p-6 shadow-xl">
    <div class="flex items-center justify-between mb-4">
      <div>
        <p class="text-sm font-semibold text-slate-100">Edit profile</p>
        <p class="text-xs text-slate-400 mt-1">
          You can update your name, username, phone and country here.
        </p>
      </div>
    </div>

<form action="/account/update" method="POST" class="space-y-4 text-sm">

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="text-xs text-slate-400 mb-1 block">Full name</label>
          <input
            type="text"
            name="name"
            value="<%= user.name %>"
            class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-700 text-xs focus:outline-none focus:border-primary-600 focus:ring-1 focus:ring-primary-600">
        </div>

        <div>
          <label class="text-xs text-slate-400 mb-1 block">Username</label>
          <input
            type="text"
            name="username"
            value="<%= user.username %>"
            class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-700 text-xs focus:outline-none focus:border-primary-600 focus:ring-1 focus:ring-primary-600">
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="text-xs text-slate-400 mb-1 block">Email</label>
          <input
            type="email"
            name="email"
            value="<%= user.email || '' %>"
            class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-700 text-xs focus:outline-none focus:border-primary-600 focus:ring-1 focus:ring-primary-600">
          <p class="mt-1 text-[11px] text-slate-500">
            Email status updates after account verification is completed.
          </p>
        </div>

        <div>
          <label class="text-xs text-slate-400 mb-1 block">Phone</label>
          <input
            type="text"
            name="phone"
            value="<%= user.phone || '' %>"
            class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-700 text-xs focus:outline-none focus:border-primary-600 focus:ring-1 focus:ring-primary-600">
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="text-xs text-slate-400 mb-1 block">Country</label>
          <select
            id="country"
            name="country"
            data-current="<%= user.country || '' %>"
            class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-700 text-xs focus:outline-none focus:border-primary-600 focus:ring-1 focus:ring-primary-600">
            <option value="">Select country</option>
          </select>
        </div>

        <div>
          <label class="text-xs text-slate-400 mb-1 block">Time zone</label>
          <select
            id="timezone"
            name="timezone"
            data-current="<%= user.timezone || '' %>"
            class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-700 text-xs focus:outline-none focus:border-primary-600 focus:ring-1 focus:ring-primary-600">
            <option value="">Select time zone</option>
          </select>
        </div>
      </div>

      <div>
        <label class="text-xs text-slate-400 mb-1 block">New password</label>
        <input
          type="password"
          name="password"
          placeholder="Leave blank to keep current password"
          class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-700 text-xs focus:outline-none focus:border-primary-600 focus:ring-1 focus:ring-primary-600">
      </div>

      <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-800 mt-4">
        <a href="/dashboard" class="px-4 py-2 rounded-xl bg-slate-900 border border-slate-700 text-xs font-semibold text-slate-200">
          Cancel
        </a>
        <button
          type="submit"
          class="px-5 py-2 rounded-xl bg-primary-600 text-xs font-semibold">
          Save changes
        </button>
      </div>

    </form>
  </section>

</div>

</main> <script>
const isoCountries = ['AF','AX','AL','DZ','AS','AD','AO','AI','AQ','AG','AR','AM','AW','AU','AT','AZ','BS','BH','BD','BB','BY','BE','BZ','BJ','BM','BT','BO','BQ','BA','BW','BV','BR','IO','BN','BG','BF','BI','CV','KH','CM','CA','KY','CF','TD','CL','CN','CX','CC','CO','KM','CG','CD','CK','CR','CI','HR','CU','CW','CY','CZ','DK','DJ','DM','DO','EC','EG','SV','GQ','ER','EE','SZ','ET','FK','FO','FJ','FI','FR','GF','PF','TF','GA','GM','GE','DE','GH','GI','GR','GL','GD','GP','GU','GT','GG','GN','GW','GY','HT','HM','VA','HN','HK','HU','IS','IN','ID','IR','IQ','IE','IM','IL','IT','JM','JP','JE','JO','KZ','KE','KI','KP','KR','KW','KG','LA','LV','LB','LS','LR','LY','LI','LT','LU','MO','MG','MW','MY','MV','ML','MT','MH','MQ','MR','MU','YT','MX','FM','MD','MC','MN','ME','MS','MA','MZ','MM','NA','NR','NP','NL','NC','NZ','NI','NE','NG','NU','NF','MK','MP','NO','OM','PK','PW','PS','PA','PG','PY','PE','PH','PN','PL','PT','PR','QA','RE','RO','RU','RW','BL','SH','KN','LC','MF','PM','VC','WS','SM','ST','SA','SN','RS','SC','SL','SG','SX','SK','SI','SB','SO','ZA','GS','SS','ES','LK','SD','SR','SJ','SE','CH','SY','TW','TJ','TZ','TH','TL','TG','TK','TO','TT','TN','TR','TM','TC','TV','UG','UA','AE','GB','US','UM','UY','UZ','VU','VE','VN','VG','VI','WF','EH','YE','ZM','ZW'];

function populateAccountCountry() {
  const country = document.getElementById('country');
  if (!country) return;
  const current = country.dataset.current || '';
  const names = typeof Intl !== 'undefined' && Intl.DisplayNames ? new Intl.DisplayNames(['en'], { type: 'region' }) : null;
  isoCountries
    .map(code => ({ code, name: names ? names.of(code) : code }))
    .filter(item => item.name)
    .sort((a, b) => a.name.localeCompare(b.name))
    .forEach(item => {
      const option = document.createElement('option');
      option.value = item.code;
      option.textContent = item.name;
      country.appendChild(option);
    });
  country.value = current;
}

function populateAccountTimezone() {
  const timezone = document.getElementById('timezone');
  if (!timezone) return;
  const current = timezone.dataset.current || Intl.DateTimeFormat().resolvedOptions().timeZone || '';
  const zones = Intl.supportedValuesOf ? Intl.supportedValuesOf('timeZone') : [];
  zones.forEach(zone => {
    const option = document.createElement('option');
    option.value = zone;
    option.textContent = zone.replace(/_/g, ' ');
    timezone.appendChild(option);
  });
  timezone.value = current;
}

populateAccountCountry();
populateAccountTimezone();
if (typeof lucide !== 'undefined') { lucide.createIcons() }
</script> <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<% if (toast) { %>

<script> Swal.fire({ icon: '<%= toast.type %>', title: '<%= toast.message %>', toast: true, position: 'top', showConfirmButton: false, timer: 2500 }) </script>

<% } %>

  <%- include('mobile-downbar') %>
</body> </html>
