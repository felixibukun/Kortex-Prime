<!DOCTYPE html>
<html lang="en" class="dark h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Copy Trading | Professional Platform</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
  <style>
    .gradient-bg {
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
    }
    .card-glow:hover {
      box-shadow: 0 0 30px rgba(79, 70, 229, 0.15);
    }
    .profit-positive {
      background: linear-gradient(90deg, rgba(34, 197, 94, 0.1), transparent);
      color: #22c55e;
    }
    .stat-gradient {
      background: linear-gradient(135deg, rgba(79, 70, 229, 0.1), rgba(147, 51, 234, 0.1));
    }
  </style>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif']
          },
          colors: {
            primary: {
              50: '#eef2ff',
              100: '#e0e7ff',
              400: '#818cf8',
              500: '#6366f1',
              600: '#4f46e5',
              700: '#4338ca',
            },
            success: '#22c55e',
            warning: '#f59e0b',
            danger: '#ef4444'
          },
          animation: {
            'fade-in': 'fadeIn 0.5s ease-in-out',
            'slide-up': 'slideUp 0.3s ease-out',
            'pulse-slow': 'pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite',
          },
          keyframes: {
            fadeIn: {
              '0%': { opacity: '0' },
              '100%': { opacity: '1' }
            },
            slideUp: {
              '0%': { transform: 'translateY(10px)', opacity: '0' },
              '100%': { transform: 'translateY(0)', opacity: '1' }
            }
          }
        }
      }
    }
  </script>
<link rel="stylesheet" href="/css/premium-ui.css">
</head>
<body class="min-h-screen gradient-bg text-white" x-data="{ selectedTrader: null, investmentAmount: 500 }">
  <div class="min-h-screen flex flex-col">
    <!-- Premium Header -->
    <header class="h-16 border-b border-slate-800/50 bg-slate-950/40 backdrop-blur-2xl flex items-center sticky top-0 z-50">
      <div class="w-full max-w-7xl mx-auto px-6 flex items-center justify-between">
        <div class="flex items-center space-x-2">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-primary-600 to-purple-600 flex items-center justify-center">
            <i data-lucide="trending-up" class="w-4 h-4"></i>
          </div>
          <span class="text-lg font-bold bg-gradient-to-r from-primary-400 to-purple-400 bg-clip-text text-transparent">
            CopyTrader Pro
          </span>
        </div>
        
        <div class="flex items-center space-x-4">
          <!-- Funding source for copy-trader purchases -->
          <div class="hidden md:flex items-center space-x-2 px-3 py-1.5 rounded-lg bg-slate-800/50 border border-slate-700">
            <i data-lucide="wallet" class="w-4 h-4 text-primary-400"></i>
            <span class="text-sm text-slate-400">Total Deposit:</span>
            <span class="text-sm font-bold text-white">$<%= (user.deposit || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span>
          </div>
          <div class="hidden md:flex items-center space-x-2 text-sm text-slate-400">
            <i data-lucide="shield" class="w-4 h-4"></i>
            <span>Secure Trading</span>
          </div>
          <a href="/dashboard" class="flex items-center space-x-2 text-sm text-slate-300 hover:text-white transition-colors px-4 py-2 rounded-lg hover:bg-slate-800/50">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            <span>Back to Dashboard</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 py-8 animate-fade-in">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Header Section -->
        <div class="mb-8">
          <h1 class="text-2xl md:text-3xl font-bold mb-2">Professional Copy Trading</h1>
          <p class="text-slate-400 max-w-3xl">
            Select from our verified professional traders. Copy their strategies automatically with real-time execution.
            <span class="text-primary-400 font-medium">Funds are deducted from your total deposit when you start copying.</span>
          </p>
        </div>

        <!-- Stats Bar -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
          <div class="stat-gradient rounded-xl p-4 border border-slate-800/50">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-xs text-slate-400 mb-1">Total Deposit</p>
                <p class="text-xl font-bold text-primary-400">$<%= (user.deposit || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></p>
              </div>
              <i data-lucide="wallet" class="w-5 h-5 text-primary-400"></i>
            </div>
          </div>
          <div class="stat-gradient rounded-xl p-4 border border-slate-800/50">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-xs text-slate-400 mb-1">Active Traders</p>
                <p class="text-xl font-bold"><%= traders.length %></p>
              </div>
              <i data-lucide="users" class="w-5 h-5 text-primary-400"></i>
            </div>
          </div>
          <div class="bg-slate-900/50 rounded-xl p-4 border border-slate-800/50">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-xs text-slate-400 mb-1">Avg. Win Rate</p>
                <p class="text-xl font-bold text-success">
                  <% 
                    const avgWinrate = traders.reduce((acc, t) => acc + parseFloat(t.winrate || t.winRate || 0), 0) / (traders.length || 1);
                  %>
                  <%= avgWinrate.toFixed(1) %>%
                </p>
              </div>
              <i data-lucide="target" class="w-5 h-5 text-success"></i>
            </div>
          </div>
          <div class="bg-slate-900/50 rounded-xl p-4 border border-slate-800/50">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-xs text-slate-400 mb-1">Total Profits</p>
                <p class="text-xl font-bold text-warning">
                  $<% 
                    const totalProfit = traders.reduce((acc, t) => acc + parseFloat(t.profit || 0), 0);
                  %>
                  <%= totalProfit.toLocaleString() %>
                </p>
              </div>
              <i data-lucide="dollar-sign" class="w-5 h-5 text-warning"></i>
            </div>
          </div>
        </div>

        <!-- Traders Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-6">
          <% traders.forEach(trader => { 
            const minAmount = trader.minAmount || 100;
            const winRate = trader.winrate || trader.winRate || 0;
          %>
          <div class="bg-slate-900/60 backdrop-blur-sm rounded-2xl border border-slate-800/70 overflow-hidden card-glow transition-all duration-300 hover:scale-[1.02]">
            <!-- Trader Header -->
            <div class="p-6 border-b border-slate-800/50">
              <div class="flex items-center justify-between mb-4">
                <div class="flex items-center space-x-3">
                  <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-primary-600/20 to-purple-600/20 flex items-center justify-center">
                    <i data-lucide="user-check" class="w-6 h-6 text-primary-400"></i>
                  </div>
                  <div>
                    <h3 class="font-bold text-lg"><%= trader.name %></h3>
                    <div class="flex items-center space-x-2">
                      <span class="text-xs px-2 py-1 rounded-full <%= winRate > 70 ? 'bg-green-900/30 text-success' : winRate > 50 ? 'bg-yellow-900/30 text-warning' : 'bg-red-900/30 text-danger' %>">
                        <%= winRate %>% Win Rate
                      </span>
                      <span class="text-xs px-2 py-1 rounded-full bg-blue-900/30 text-primary-400">
                        Verified
                      </span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Stats Grid -->
              <div class="grid grid-cols-2 gap-3">
                <div class="space-y-1">
                  <p class="text-xs text-slate-400">Total Profit</p>
                  <p class="font-bold text-lg <%= trader.profit > 0 ? 'text-success' : 'text-danger' %>">
                    $<%= (trader.profit || 0).toLocaleString() %>
                  </p>
                </div>
                <div class="space-y-1">
                  <p class="text-xs text-slate-400">Trades</p>
                  <p class="font-bold text-lg"><%= trader.trades || Math.floor(Math.random() * 200) + 50 %></p>
                </div>
                <div class="space-y-1">
                  <p class="text-xs text-slate-400">Risk Level</p>
                  <div class="flex items-center">
                    <% const risk = winRate > 80 ? 1 : winRate > 60 ? 2 : 3; %>
                    <% for(let i = 1; i <= 3; i++) { %>
                      <div class="w-2 h-2 rounded-full mx-1 <%= i <= risk ? (risk === 1 ? 'bg-success' : risk === 2 ? 'bg-warning' : 'bg-danger') : 'bg-slate-700' %>"></div>
                    <% } %>
                    <span class="text-xs ml-2"><%= risk === 1 ? 'Low' : risk === 2 ? 'Medium' : 'High' %></span>
                  </div>
                </div>
                <div class="space-y-1">
                  <p class="text-xs text-slate-400">Min. Copy</p>
                  <p class="font-bold text-lg">$<%= minAmount %></p>
                </div>
              </div>
            </div>

            <!-- Copy Form - FIXED: Shows deduction warning -->
            <div class="p-6">
              <form action="/copy-trader/follow" method="POST" class="space-y-4" onsubmit="return confirmCopyTrade(this)">
                <input type="hidden" name="traderId" value="<%= trader.id %>">
                
                <div>
                  <label class="text-xs text-slate-400 mb-2 block">Investment Amount (will be deducted from total deposit)</label>
                  <div class="relative">
                    <div class="absolute left-3 top-1/2 transform -translate-y-1/2">
                      <i data-lucide="dollar-sign" class="w-4 h-4 text-slate-500"></i>
                    </div>
                    <input
                      type="number"
                      name="amount"
                      required
                      min="<%= minAmount %>"
                      step="100"
                      value="<%= minAmount %>"
                      placeholder="Enter amount (min: $<%= minAmount %>)"
                      class="w-full pl-10 pr-4 py-3 rounded-xl bg-slate-800/50 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all"
                      data-balance="<%= user.deposit || 0 %>"
                      onchange="updateAmountWarning(this, <%= user.deposit || 0 %>, <%= minAmount %>)"
                    >
                  </div>
                  <p class="text-xs text-slate-500 mt-2 flex items-center gap-1">
                    <i data-lucide="info" class="w-3 h-3"></i>
                    <span id="warning-<%= trader.id %>">Amount will be deducted immediately from your total deposit</span>
                  </p>
                </div>

                <div class="space-y-3">
                  <button
                    type="submit"
                    class="w-full py-3 rounded-xl bg-gradient-to-r from-primary-600 to-purple-600 hover:from-primary-700 hover:to-purple-700 text-white font-semibold transition-all duration-300 hover:shadow-lg hover:shadow-primary-600/25 flex items-center justify-center space-x-2"
                  >
                    <i data-lucide="copy" class="w-4 h-4"></i>
                    <span>Copy This Trader</span>
                  </button>
                  
                  <div class="text-center">
                    <p class="text-xs text-slate-500">
                      By copying, you agree to deduct the investment amount from your total deposit
                    </p>
                  </div>
                </div>
              </form>
            </div>
          </div>
          <% }) %>
        </div>

        <!-- My Active Copies Section -->
        <% if (following && following.length > 0) { %>
        <div class="mt-12">
          <h2 class="text-xl font-bold mb-4">Your Active Copy Trades</h2>
          <div class="bg-slate-900/40 rounded-2xl border border-slate-800/50 overflow-hidden">
            <div class="overflow-x-auto">
              <table class="w-full">
                <thead class="bg-slate-800/50 border-b border-slate-700">
                  <tr>
                    <th class="text-left p-4 text-sm font-medium text-slate-400">Trader</th>
                    <th class="text-left p-4 text-sm font-medium text-slate-400">Amount Invested</th>
                    <th class="text-left p-4 text-sm font-medium text-slate-400">Started</th>
                    <th class="text-left p-4 text-sm font-medium text-slate-400">Status</th>
                    <th class="text-left p-4 text-sm font-medium text-slate-400">Action</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-800">
                  <% following.forEach(follow => { %>
                  <tr class="hover:bg-slate-800/30 transition-colors">
                    <td class="p-4 font-medium"><%= follow.traderName %></td>
                    <td class="p-4 text-success font-bold">$<%= follow.amount.toLocaleString() %></td>
                    <td class="p-4 text-slate-400 text-sm"><%= new Date(follow.startedAt).toLocaleDateString() %></td>
                    <td class="p-4">
                      <span class="text-xs px-2 py-1 rounded-full bg-green-900/30 text-success">Active</span>
                    </td>
                    <td class="p-4">
                      <form action="/copy-trader/stop" method="POST" onsubmit="return confirm('Stop this copy trade? The allocated amount will be refunded to your total deposit.')">
                        <input type="hidden" name="followId" value="<%= follow.id %>">
                        <input type="hidden" name="traderId" value="<%= follow.traderId %>">
                        <button type="submit" class="text-xs text-danger hover:text-danger/80 transition-colors">Stop Copying</button>
                      </form>
                    </td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
        <% } %>

        <!-- Footer Note -->
        <div class="mt-12 pt-8 border-t border-slate-800/50">
          <div class="max-w-3xl mx-auto text-center">
            <div class="flex items-center justify-center space-x-2 text-slate-400 mb-3">
              <i data-lucide="shield-check" class="w-4 h-4"></i>
              <p class="text-sm">Your funds are secured with bank-level encryption</p>
            </div>
            <p class="text-xs text-slate-500">
              Past performance is not indicative of future results. Trading involves risk. Only invest what you can afford to lose.
            </p>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      // Initialize Lucide icons
      if (typeof lucide !== 'undefined') {
        lucide.createIcons();
      }

      // Add input formatting
      document.querySelectorAll('input[type="number"]').forEach(input => {
        input.addEventListener('input', function(e) {
          const min = parseFloat(this.getAttribute('min'));
          const value = parseFloat(this.value);
          const balance = parseFloat(this.getAttribute('data-balance') || 0);
          
          if (value < min) {
            this.style.borderColor = '#ef4444';
            this.style.boxShadow = '0 0 0 2px rgba(239, 68, 68, 0.2)';
          } else if (value > balance) {
            this.style.borderColor = '#ef4444';
            this.style.boxShadow = '0 0 0 2px rgba(239, 68, 68, 0.2)';
          } else {
            this.style.borderColor = '';
            this.style.boxShadow = '';
          }
        });
      });

      // Add trader card animations
      document.querySelectorAll('.card-glow').forEach((card, index) => {
        card.style.animationDelay = `${index * 100}ms`;
      });
    });

    // Confirmation before copying
    function confirmCopyTrade(form) {
      const amount = form.querySelector('input[name="amount"]').value;
      const traderName = form.closest('.card-glow')?.querySelector('h3')?.innerText || 'this trader';
      
      return Swal.fire({
        title: 'Confirm Copy Trade',
        html: `Are you sure you want to copy ${traderName} with <strong>$${parseFloat(amount).toLocaleString()}</strong>?<br><br>This amount will be <strong class="text-danger">DEDUCTED</strong> from your total deposit.`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#4f46e5',
        cancelButtonColor: '#ef4444',
        confirmButtonText: 'Yes, proceed',
        cancelButtonText: 'Cancel',
        background: '#1e293b',
        color: '#f8fafc'
      }).then((result) => {
        if (result.isConfirmed) {
          form.submit();
        }
        return false;
      });
      return false;
    }

    function updateAmountWarning(input, balance, minAmount) {
      const amount = parseFloat(input.value);
      const warningSpan = document.getElementById(`warning-${input.closest('.card-glow')?.querySelector('input[name="traderId"]')?.value}`);
      
      if (isNaN(amount)) {
        input.value = minAmount;
      } else if (amount > balance) {
        input.style.borderColor = '#ef4444';
        Swal.fire({
          title: 'Insufficient Total Deposit',
          text: `You only have $${balance.toLocaleString()} in your total deposit. Please enter a lower amount.`,
          icon: 'error',
          background: '#1e293b',
          color: '#f8fafc'
        });
        input.value = Math.min(balance, minAmount);
      } else if (amount < minAmount) {
        input.style.borderColor = '#ef4444';
        input.value = minAmount;
      } else {
        input.style.borderColor = '';
      }
    }
  </script>

  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <% if (toast) { %>
  <script>
    Swal.fire({
      icon: '<%= toast.type %>',
      title: '<%= toast.message %>',
      toast: true,
      position: 'top-end',
      showConfirmButton: false,
      timer: 3000,
      background: '#1e293b',
      color: '#f8fafc',
      iconColor: '<%= toast.type === "success" ? "#22c55e" : toast.type === "error" ? "#ef4444" : "#f59e0b" %>',
      timerProgressBar: true
    })
  </script>
  <% } %>
  <%- include('mobile-downbar') %>
</body>
</html>
