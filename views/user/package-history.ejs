<!DOCTYPE html>
<html class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Package History | Kortex Prime</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/premium-ui.css">
</head>

<body class="min-h-screen bg-slate-950 text-white">
  <div class="fixed inset-0 -z-10">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(14,165,233,0.16),transparent_34%),radial-gradient(circle_at_bottom_right,rgba(245,158,11,0.1),transparent_34%)]"></div>
    <div class="absolute inset-0 bg-slate-950/85"></div>
  </div>

  <header class="sticky top-0 z-40 border-b border-slate-800 bg-slate-950/85 backdrop-blur-xl">
    <div class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between px-4">
      <div>
        <p class="text-sm font-black text-white">Package History</p>
        <p class="text-[11px] text-slate-500">Subscriptions funded from total deposit</p>
      </div>
      <div class="flex items-center gap-2">
        <a href="/packages" class="rounded-xl border border-cyan-400/20 bg-cyan-400/10 px-4 py-2 text-xs font-bold text-cyan-300 hover:bg-cyan-400/20">View Packages</a>
        <a href="/dashboard" class="rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-xs font-semibold text-slate-300 hover:text-white">Back</a>
      </div>
    </div>
  </header>

  <main class="mx-auto w-full max-w-6xl px-4 py-8">
    <section class="mb-6 grid gap-4 md:grid-cols-3">
      <div class="rounded-3xl border border-white/10 bg-slate-900/70 p-5">
        <p class="text-[11px] uppercase tracking-[0.16em] text-slate-500">Total Packages</p>
        <p class="mt-2 text-3xl font-black"><%= subs ? subs.length : 0 %></p>
      </div>
      <div class="rounded-3xl border border-white/10 bg-slate-900/70 p-5">
        <p class="text-[11px] uppercase tracking-[0.16em] text-slate-500">Active</p>
        <p class="mt-2 text-3xl font-black text-emerald-300"><%= subs ? subs.filter(s => (s.status || 'active') === 'active').length : 0 %></p>
      </div>
      <div class="rounded-3xl border border-white/10 bg-slate-900/70 p-5">
        <p class="text-[11px] uppercase tracking-[0.16em] text-slate-500">Total Spent</p>
        <p class="mt-2 text-3xl font-black text-cyan-300">$<%= (subs || []).reduce((sum, s) => sum + Number(s.price || 0), 0).toLocaleString('en-US', { minimumFractionDigits: 2 }) %></p>
      </div>
    </section>

    <section class="overflow-hidden rounded-3xl border border-white/10 bg-slate-900/80 shadow-2xl shadow-black/30">
      <div class="border-b border-white/10 px-6 py-5">
        <h1 class="text-xl font-black">Your Subscriptions</h1>
        <p class="mt-1 text-sm text-slate-500">Track every package activation, price, projected rate, and status.</p>
      </div>

      <% if (!subs || subs.length === 0) { %>
        <div class="flex min-h-[300px] flex-col items-center justify-center px-6 py-12 text-center">
          <div class="mb-5 flex h-16 w-16 items-center justify-center rounded-2xl border border-white/10 bg-white/5">
            <span class="text-2xl">$</span>
          </div>
          <h2 class="text-lg font-bold">No package subscriptions yet</h2>
          <p class="mt-2 max-w-md text-sm leading-6 text-slate-500">When you subscribe to a package, it will appear here with the amount deducted from your total deposit and activation date.</p>
          <a href="/packages" class="mt-6 rounded-xl bg-cyan-400 px-5 py-3 text-sm font-bold text-slate-950 hover:bg-cyan-300">Choose Package</a>
        </div>
      <% } else { %>
        <div class="divide-y divide-white/10">
          <% subs.forEach((s, index) => {
            const date = s.subscribedAt || s.date || s.createdAt;
            const status = s.status || 'active';
          %>
            <article class="grid gap-4 px-6 py-5 transition hover:bg-white/[0.03] md:grid-cols-[1fr_auto] md:items-center">
              <div>
                <div class="flex flex-wrap items-center gap-3">
                  <h2 class="text-lg font-black text-white"><%= s.package %></h2>
                  <span class="rounded-full border <%= status === 'active' ? 'border-emerald-400/20 bg-emerald-400/10 text-emerald-300' : 'border-slate-500/20 bg-slate-500/10 text-slate-300' %> px-3 py-1 text-[11px] font-bold uppercase tracking-wide"><%= status %></span>
                </div>
                <p class="mt-2 text-sm text-slate-500">Activated <%= date ? new Date(date).toLocaleString() : 'recently' %></p>
              </div>
              <div class="grid grid-cols-2 gap-3 text-right md:min-w-[260px]">
                <div class="rounded-2xl border border-white/10 bg-slate-950/50 p-4">
                  <p class="text-[10px] uppercase tracking-wider text-slate-500">Price</p>
                  <p class="mt-1 font-black text-white">$<%= Number(s.price || 0).toLocaleString('en-US', { minimumFractionDigits: 2 }) %></p>
                </div>
                <div class="rounded-2xl border border-white/10 bg-slate-950/50 p-4">
                  <p class="text-[10px] uppercase tracking-wider text-slate-500">Projected</p>
                  <p class="mt-1 font-black text-cyan-300"><%= s.profit || 'N/A' %></p>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>
  </main>

  <%- include('mobile-downbar') %>
</body>
</html>
