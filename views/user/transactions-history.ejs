<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Funding History | Kortex Prime</title>
  
  <!-- Premium Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/premium-ui.css">
  
  <!-- AOS Animation Library -->
  <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: { 
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace']
          },
          animation: {
            'float': 'float 6s ease-in-out infinite',
            'slide-up': 'slideUp 0.5s ease-out',
            'fade-in': 'fadeIn 0.6s ease-out',
            'pulse-soft': 'pulseSoft 2s cubic-bezier(0.4, 0, 0.6, 1) infinite',
            'shimmer': 'shimmer 2s linear infinite',
          },
          keyframes: {
            float: {
              '0%, 100%': { transform: 'translateY(0px)' },
              '50%': { transform: 'translateY(-10px)' },
            },
            slideUp: {
              '0%': { transform: 'translateY(20px)', opacity: '0' },
              '100%': { transform: 'translateY(0)', opacity: '1' },
            },
            fadeIn: {
              '0%': { opacity: '0' },
              '100%': { opacity: '1' },
            },
            pulseSoft: {
              '0%, 100%': { opacity: '1' },
              '50%': { opacity: '0.7' },
            },
            shimmer: {
              '0%': { backgroundPosition: '-200% 0' },
              '100%': { backgroundPosition: '200% 0' },
            },
          }
        }
      }
    }
  </script>

  <style>
    /* Premium scrollbar */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #020617; }
    ::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 10px; }
    ::-webkit-scrollbar-thumb:hover { background: #334155; }

    /* Glass morphism */
    .glass-card {
      background: rgba(15, 23, 42, 0.6);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .glass-item {
      background: rgba(15, 23, 42, 0.5);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.06);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .glass-item:hover {
      background: rgba(30, 41, 59, 0.6);
      border-color: rgba(6, 182, 212, 0.3);
      transform: translateX(4px);
      box-shadow: 0 10px 30px -10px rgba(6, 182, 212, 0.15);
    }

    /* Gradient text */
    .gradient-text {
      background: linear-gradient(135deg, #22d3ee, #3b82f6);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* Status badges */
    .badge-approved {
      background: rgba(16, 185, 129, 0.15);
      border: 1px solid rgba(16, 185, 129, 0.3);
      color: #34d399;
    }

    .badge-pending {
      background: rgba(245, 158, 11, 0.15);
      border: 1px solid rgba(245, 158, 11, 0.3);
      color: #fbbf24;
      animation: pulseSoft 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }

    .badge-rejected {
      background: rgba(239, 68, 68, 0.15);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: #f87171;
    }

    .badge-profit {
      background: rgba(59, 130, 246, 0.15);
      border: 1px solid rgba(59, 130, 246, 0.3);
      color: #60a5fa;
    }

    /* Type badges */
    .type-deposit {
      background: rgba(16, 185, 129, 0.12);
      color: #34d399;
    }

    .type-withdrawal {
      background: rgba(239, 68, 68, 0.12);
      color: #f87171;
    }

    .type-profit {
      background: rgba(59, 130, 246, 0.12);
      color: #60a5fa;
    }

    .type-bonus {
      background: rgba(139, 92, 246, 0.12);
      color: #a78bfa;
    }

    .type-trade {
      background: rgba(245, 158, 11, 0.12);
      color: #fbbf24;
    }

    /* Hover lift effect */
    .hover-lift {
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .hover-lift:hover {
      transform: translateY(-2px);
      box-shadow: 0 20px 40px -15px rgba(6, 182, 212, 0.2);
    }

    /* Amount colors */
    .amount-positive {
      color: #34d399;
    }
    .amount-negative {
      color: #f87171;
    }
  </style>
</head>

<body class="min-h-screen bg-slate-950 font-sans text-white">

  <!-- Animated Background -->
  <div class="fixed inset-0 -z-10">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(14,165,233,0.15),transparent_35%),radial-gradient(circle_at_bottom_right,rgba(139,92,246,0.1),transparent_35%)]"></div>
    <div class="absolute inset-0 bg-slate-950/90"></div>
    
    <!-- Animated particles -->
    <div class="absolute top-20 left-10 w-2 h-2 bg-cyan-400/30 rounded-full animate-float"></div>
    <div class="absolute top-40 right-20 w-3 h-3 bg-purple-400/20 rounded-full animate-float" style="animation-delay: 2s;"></div>
    <div class="absolute bottom-40 left-1/4 w-2 h-2 bg-blue-400/25 rounded-full animate-float" style="animation-delay: 4s;"></div>
  </div>

  <!-- Header -->
  <header class="sticky top-0 z-40 h-16 border-b border-white/10 bg-slate-950/80 backdrop-blur-xl">
    <div class="mx-auto flex h-full w-full max-w-5xl items-center justify-between px-4">
      <div class="flex items-center gap-3">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
          </svg>
          <p class="text-sm font-bold tracking-wide">
            <span class="gradient-text">Funding History</span>
          </p>
        </div>
      </div>

      <a href="/dashboard" 
         class="group flex items-center gap-2 rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-xs font-semibold text-slate-300 transition hover:border-cyan-400/40 hover:bg-cyan-400/10 hover:text-white hover:shadow-lg hover:shadow-cyan-400/10">
        <svg class="w-4 h-4 transition group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Back to Dashboard
      </a>
    </div>
  </header>

  <!-- Main Content -->
  <main class="mx-auto w-full max-w-5xl px-4 py-8">

    <!-- Stats Overview -->
    <div class="mb-6 grid grid-cols-2 gap-4 sm:grid-cols-4" data-aos="fade-up" data-aos-duration="600">
      <div class="glass-card rounded-2xl p-4 hover-lift">
        <p class="text-[11px] uppercase tracking-[0.15em] text-slate-500">Funding Records</p>
        <p class="mt-1 font-mono text-xl font-bold text-white">
          <%= transactions ? transactions.length : 0 %>
        </p>
      </div>
      <div class="glass-card rounded-2xl p-4 hover-lift">
        <p class="text-[11px] uppercase tracking-[0.15em] text-slate-500">Deposits</p>
        <p class="mt-1 font-mono text-xl font-bold text-emerald-400">
          <%= transactions ? transactions.filter(t => t.type === 'deposit').length : 0 %>
        </p>
      </div>
      <div class="glass-card rounded-2xl p-4 hover-lift">
        <p class="text-[11px] uppercase tracking-[0.15em] text-slate-500">Withdrawals</p>
        <p class="mt-1 font-mono text-xl font-bold text-red-400">
          <%= transactions ? transactions.filter(t => t.type === 'withdrawal').length : 0 %>
        </p>
      </div>
      <div class="glass-card rounded-2xl p-4 hover-lift">
        <p class="text-[11px] uppercase tracking-[0.15em] text-slate-500">Profits</p>
        <p class="mt-1 font-mono text-xl font-bold text-blue-400">
          <%= transactions ? transactions.filter(t => t.type === 'profit' || t.status === 'profit').length : 0 %>
        </p>
      </div>
    </div>

    <!-- Funding History Card -->
    <div class="glass-card rounded-3xl p-6 shadow-2xl shadow-black/30" data-aos="fade-up" data-aos-duration="700" data-aos-delay="200">
      
      <!-- Header -->
      <div class="mb-6 flex items-center justify-between">
        <div>
          <h2 class="text-lg font-bold text-white flex items-center gap-2">
            <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            Funding Records
          </h2>
          <p class="mt-1 text-xs text-slate-500">Complete history of deposits and withdrawals</p>
        </div>
        
        <% if (transactions && transactions.length > 0) { %>
          <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-[11px] font-semibold text-slate-400">
            <%= transactions.length %> funding record<%= transactions.length > 1 ? 's' : '' %>
          </span>
        <% } %>
      </div>

      <!-- Empty State -->
      <% if (!transactions || transactions.length === 0) { %>
        <div class="flex min-h-[350px] flex-col items-center justify-center py-12 text-center animate-fade-in">
          <div class="mb-6 flex h-20 w-20 items-center justify-center rounded-2xl border border-white/10 bg-white/5">
            <svg class="w-10 h-10 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">No funding records yet</h3>
          <p class="max-w-sm text-sm leading-6 text-slate-500">
            Deposits and withdrawals will appear here. Start by funding your account or making a withdrawal.
          </p>
          <div class="mt-6 flex gap-3">
            <a href="/deposit-withdrawal" class="inline-flex items-center gap-2 rounded-xl bg-emerald-400/10 border border-emerald-400/20 px-5 py-2.5 text-sm font-semibold text-emerald-300 hover:bg-emerald-400/20 transition">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
              </svg>
              Deposit
            </a>
            <a href="/withdraw" class="inline-flex items-center gap-2 rounded-xl bg-cyan-400/10 border border-cyan-400/20 px-5 py-2.5 text-sm font-semibold text-cyan-300 hover:bg-cyan-400/20 transition">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
              Withdraw
            </a>
          </div>
        </div>
      <% } else { %>

        <!-- Funding Records List -->
        <div class="space-y-3">
          <% transactions.forEach((t, index) => { 
            const type = (t.type || '').toLowerCase();
            const isDeposit = type === 'deposit';
            const isWithdrawal = type === 'withdrawal';
            const isProfit = type === 'profit' || t.status === 'profit';
            
            let typeClass = 'type-deposit';
            let typeIcon = 'M12 6v6m0 0v6m0-6h6m-6 0H6'; // plus
            let typeLabel = 'Deposit';
            
            if (isWithdrawal) {
              typeClass = 'type-withdrawal';
              typeIcon = 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z';
              typeLabel = 'Withdrawal';
            } else if (isProfit) {
              typeClass = 'type-profit';
              typeIcon = 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6';
              typeLabel = 'Profit';
            } else if (type === 'bonus') {
              typeClass = 'type-bonus';
              typeIcon = 'M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7';
              typeLabel = 'Bonus';
            } else if (type === 'trade') {
              typeClass = 'type-trade';
              typeIcon = 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z';
              typeLabel = 'Trade';
            }
          %>
            <div class="glass-item rounded-2xl p-5 animate-slide-up" style="animation-delay: <%= index * 0.06 %>s">
              
              <!-- Top Row: Type & Amount -->
              <div class="flex items-start justify-between gap-4 mb-4">
                <div class="flex items-center gap-3">
                  <div class="flex h-10 w-10 items-center justify-center rounded-xl <%= typeClass %>">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= typeIcon %>"/>
                    </svg>
                  </div>
                  <div>
                    <p class="font-semibold text-white text-sm capitalize"><%= typeLabel %></p>
                    <p class="text-[11px] text-slate-500"><%= t.method || t.network || t.walletType || '' %></p>
                  </div>
                </div>

                <div class="text-right">
                  <p class="font-mono text-lg font-black <%= isDeposit || isProfit ? 'amount-positive' : 'amount-negative' %>">
                    <%= isDeposit || isProfit ? '+' : '-' %>$<%= Number(t.amount || 0).toFixed(2) %>
                  </p>
                </div>
              </div>

              <!-- Bottom Grid: Status & Date -->
              <div class="grid grid-cols-2 gap-3 rounded-xl border border-white/5 bg-slate-950/50 p-4 text-xs">
                <div>
                  <p class="text-slate-500 uppercase tracking-wide mb-1.5">Status</p>
                  <% if (t.status === 'approved' || t.status === 'profit') { %>
                    <span class="badge-approved inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[11px] font-bold uppercase">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                      </svg>
                      <%= t.status %>
                    </span>
                  <% } else if (t.status === 'pending') { %>
                    <span class="badge-pending inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[11px] font-bold uppercase">
                      <svg class="w-3 h-3 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                      </svg>
                      Pending
                    </span>
                  <% } else { %>
                    <span class="badge-rejected inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[11px] font-bold uppercase">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                      </svg>
                      <%= t.status || 'Rejected' %>
                    </span>
                  <% } %>
                </div>
                <div>
                  <p class="text-slate-500 uppercase tracking-wide mb-1.5">Date</p>
                  <p class="font-mono font-semibold text-slate-300"><%= new Date(t.date || t.createdAt || Date.now()).toLocaleString() %></p>
                </div>
              </div>

            </div>
          <% }) %>
        </div>

        <!-- Summary Footer -->
        <div class="mt-6 rounded-2xl border border-white/5 bg-slate-900/50 p-4">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <p class="text-xs text-slate-500">
              Showing <%= transactions.length %> funding record<%= transactions.length > 1 ? 's' : '' %>
            </p>
            <div class="flex gap-6">
              <div>
                <p class="text-[10px] uppercase tracking-wider text-slate-600">Total Deposits</p>
                <p class="font-mono text-sm font-bold text-emerald-400">
                  +$<%= transactions.filter(t => t.type === 'deposit').reduce((sum, t) => sum + Number(t.amount || 0), 0).toFixed(2) %>
                </p>
              </div>
              <div>
                <p class="text-[10px] uppercase tracking-wider text-slate-600">Total Withdrawals</p>
                <p class="font-mono text-sm font-bold text-red-400">
                  -$<%= transactions.filter(t => t.type === 'withdrawal').reduce((sum, t) => sum + Number(t.amount || 0), 0).toFixed(2) %>
                </p>
              </div>
            </div>
          </div>
        </div>

      <% } %>

    </div>

  </main>

  <!-- Scripts -->
  <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
  <script>
    AOS.init({
      once: true,
      duration: 800,
      offset: 50
    });
  </script>

  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <% if (toast) { %>
  <script>
    Swal.fire({
      icon: '<%= toast.type %>',
      title: '<%= toast.message %>',
      toast: true,
      position: 'top-end',
      showConfirmButton: false,
      timer: 3000,
      timerProgressBar: true,
      background: '#0f172a',
      color: '#ffffff',
      customClass: {
        popup: 'rounded-2xl border border-white/10',
        title: 'text-sm font-semibold'
      },
      didOpen: (toast) => {
        toast.addEventListener('mouseenter', Swal.stopTimer)
        toast.addEventListener('mouseleave', Swal.resumeTimer)
      }
    })
  </script>
  <% } %>

  <%- include('mobile-downbar') %>
</body>
</html>
