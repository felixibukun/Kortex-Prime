<!DOCTYPE html>
<html lang="en" class="dark" x-data="{ selectedPlan: null }">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Investment Packages - <%= user.name || user.username %></title>
  <!-- Font & Core Libraries -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js" defer></script>

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'sans-serif'] },
          colors: {
            primary: {
              50: '#eff6ff',
              100: '#dbeafe',
              200: '#bfdbfe',
              300: '#93c5fd',
              400: '#60a5fa',
              500: '#3b82f6',
              600: '#2563eb',
              700: '#1d4ed8',
              800: '#1e40af',
              900: '#1e3a8a'
            },
            emerald: { 500: '#10b981', 600: '#059669' },
            amber: { 500: '#f59e0b', 600: '#d97706' }
          },
          animation: {
            'fade-in': 'fadeIn 0.5s ease-out',
            'slide-up': 'slideUp 0.3s ease-out',
            'pulse-glow': 'pulseGlow 2s ease-in-out infinite'
          },
          keyframes: {
            fadeIn: { from: { opacity: '0' }, to: { opacity: '1' } },
            slideUp: { from: { transform: 'translateY(10px)', opacity: '0' }, to: { transform: 'translateY(0)', opacity: '1' } },
            pulseGlow: { '0%, 100%': { boxShadow: '0 0 20px rgba(59, 130, 246, 0.5)' }, '50%': { boxShadow: '0 0 30px rgba(59, 130, 246, 0.8)' } }
          }
        }
      }
    }
  </script>

  <style>
    body {
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }
    .plan-card {
      transition: all 0.3s ease;
      background: linear-gradient(to bottom, rgba(30, 41, 59, 0.7), rgba(15, 23, 42, 0.9));
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.05);
    }
    .plan-card:hover {
      transform: translateY(-8px);
      border-color: rgba(59, 130, 246, 0.3);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    }
    .feature-badge {
      background: linear-gradient(135deg, #3b82f6, #8b5cf6);
      color: white;
      font-weight: 600;
      font-size: 0.7rem;
      padding: 0.25rem 0.75rem;
      border-radius: 9999px;
    }
    .popular-badge {
      background: linear-gradient(135deg, #f59e0b, #ec4899);
      color: white;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
  </style>
<link rel="stylesheet" href="/css/premium-ui.css">
</head>

<body class="text-gray-100 font-sans">

<!-- Header -->
<header class="sticky top-0 z-40 border-b border-slate-800 bg-slate-950/90 backdrop-blur-xl">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="h-16 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="/dashboard" class="p-2 rounded-lg bg-slate-800/50 hover:bg-slate-700/50 transition-colors">
          <i data-lucide="arrow-left" class="w-5 h-5"></i>
        </a>
        <div>
          <h1 class="text-xl font-bold bg-gradient-to-r from-blue-400 to-cyan-300 bg-clip-text text-transparent">
            Investment Packages
          </h1>
          <p class="text-sm text-slate-400">Choose your investment tier and start growing</p>
        </div>
      </div>
      <div class="flex items-center gap-4">
        <div class="hidden sm:block text-right">
          <p class="text-sm font-medium">Total Deposit</p>
          <p class="text-lg font-bold">$<%= Number(user.deposit || 0).toLocaleString('en-US', { minimumFractionDigits: 2 }) %></p>
        </div>
      </div>
    </div>
  </div>
</header>

<!-- Main Content -->
<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Hero Section -->
  <div class="text-center mb-12 animate-fade-in">
    <h2 class="text-3xl md:text-4xl font-bold mb-4">Strategic Investment Plans</h2>
    <p class="text-lg text-slate-300 max-w-3xl mx-auto">
      Select a package that matches your financial goals. Higher tiers offer greater weekly returns
      and exclusive features to accelerate your portfolio growth.
    </p>
  </div>

  <!-- Pricing Cards Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
    <% 
      const packages = [
        { 
          name: "Starter", 
          price: 500, 
          profit: "5%", 
          period: "weekly",
          description: "Perfect for beginning your investment journey",
          features: ["Basic Support", "Market Updates", "Email Reports"],
          popular: false,
          color: "slate"
        },
        { 
          name: "Standard", 
          price: 1000, 
          profit: "8%", 
          period: "weekly",
          description: "Enhanced returns for consistent growth",
          features: ["Priority Support", "Advanced Analytics", "Weekly Webinars", "Risk Management"],
          popular: false,
          color: "blue"
        },
        { 
          name: "Premium", 
          price: 2000, 
          profit: "12%", 
          period: "weekly",
          description: "Professional tier with premium features",
          features: ["24/7 Support", "Personal Account Manager", "Real-time Alerts", "Portfolio Review", "Exclusive Tools"],
          popular: true,
          color: "emerald"
        },
        { 
          name: "Advanced", 
          price: 5000, 
          profit: "15%", 
          period: "weekly",
          description: "High-performance investment strategy",
          features: ["VIP Support", "Custom Strategies", "Direct Trader Access", "Bi-weekly Consultations", "Advanced Reports"],
          popular: false,
          color: "purple"
        },
        { 
          name: "Gold", 
          price: 10000, 
          profit: "18%", 
          period: "weekly",
          description: "Elite level for serious investors",
          features: ["Dedicated Team", "Tailored Portfolio", "Early Access Features", "Monthly Strategy Sessions", "Premium Education"],
          popular: false,
          color: "amber"
        },
        { 
          name: "Elite", 
          price: 50000, 
          profit: "20%", 
          period: "weekly",
          description: "Ultimate institutional-grade package",
          features: ["Executive Support", "Full Customization", "Co-investment Opportunities", "Quarterly Retreats", "White-glove Service"],
          popular: false,
          color: "cyan"
        }
      ];
    %>

    <% packages.forEach((plan, index) => { %>
    <div class="plan-card rounded-2xl p-6 relative animate-slide-up"
         style="animation-delay: <%= index * 0.1 %>s"
         :class="{ 'ring-2 ring-primary-500': selectedPlan === '<%= plan.name %>' }"
         @mouseenter="selectedPlan = '<%= plan.name %>'"
         @mouseleave="selectedPlan = null">
      
      <!-- Popular Badge -->
      <% if (plan.popular) { %>
      <div class="absolute -top-3 left-1/2 transform -translate-x-1/2">
        <span class="popular-badge px-4 py-1.5 rounded-full text-xs font-bold shadow-lg">
          <i data-lucide="crown" class="w-3 h-3 inline mr-1"></i> Most Popular
        </span>
      </div>
      <% } %>

      <!-- Plan Header -->
      <div class="text-center mb-6">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-<%= plan.color %>-500/10 mb-4">
          <% if (plan.name === 'Elite') { %>
            <i data-lucide="gem" class="w-6 h-6 text-<%= plan.color %>-400"></i>
          <% } else if (plan.name === 'Gold') { %>
            <i data-lucide="award" class="w-6 h-6 text-<%= plan.color %>-400"></i>
          <% } else { %>
            <i data-lucide="trending-up" class="w-6 h-6 text-<%= plan.color %>-400"></i>
          <% } %>
        </div>
        <h3 class="text-2xl font-bold mb-2"><%= plan.name %></h3>
        <p class="text-sm text-slate-400 mb-4"><%= plan.description %></p>
      </div>

      <!-- Price -->
      <div class="text-center mb-6">
        <div class="flex items-center justify-center gap-1">
          <span class="text-3xl font-bold">$<%= plan.price.toLocaleString() %></span>
        </div>
        <p class="text-sm text-slate-400 mt-2">Deducted from total deposit</p>
      </div>

      <!-- Returns Badge -->
      <div class="text-center mb-8">
        <div class="inline-flex items-center gap-2 bg-gradient-to-r from-<%= plan.color %>-500/20 to-<%= plan.color %>-600/20 px-6 py-3 rounded-xl border border-<%= plan.color %>-500/30">
          <i data-lucide="zap" class="w-5 h-5 text-<%= plan.color %>-300"></i>
          <div class="text-left">
            <p class="text-sm font-medium text-slate-300">Projected Weekly</p>
            <p class="text-2xl font-bold text-<%= plan.color %>-300"><%= plan.profit %></p>
          </div>
        </div>
      </div>

      <!-- Features -->
      <ul class="space-y-3 mb-8">
        <% plan.features.forEach(feature => { %>
        <li class="flex items-center gap-3">
          <i data-lucide="check-circle" class="w-5 h-5 text-<%= plan.color %>-500 flex-shrink-0"></i>
          <span class="text-sm"><%= feature %></span>
        </li>
        <% }) %>
      </ul>

      <!-- CTA Button -->
      <form action="/packages/subscribe" method="POST">
        <input type="hidden" name="price" value="<%= plan.price %>">
        <button type="submit"
                class="w-full py-3 rounded-xl font-semibold transition-all duration-300 
                       bg-gradient-to-r from-<%= plan.color %>-500 to-<%= plan.color %>-600 
                       hover:from-<%= plan.color %>-600 hover:to-<%= plan.color %>-700 
                       hover:shadow-lg hover:shadow-<%= plan.color %>-500/25 
                       <%= plan.popular ? 'animate-pulse-glow' : '' %>"
                :class="{ 'scale-[1.02]': selectedPlan === '<%= plan.name %>' }"
                @mouseenter="selectedPlan = '<%= plan.name %>'">
          <div class="flex items-center justify-center gap-2">
            <i data-lucide="sparkles" class="w-4 h-4"></i>
            <span>Subscribe to <%= plan.name %></span>
          </div>
        </button>
      </form>

      <!-- Estimated Return -->
      <div class="text-center mt-4 pt-4 border-t border-slate-800/50">
        <p class="text-xs text-slate-500">
          Projected monthly: <span class="font-semibold text-slate-300">
            $<%= (plan.price * parseFloat(plan.profit) / 100 * 4.33).toFixed(0) %>
          </span>
        </p>
      </div>
    </div>
    <% }) %>
  </div>

  <!-- Comparison & Info Section -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Package Projection -->
    <div class="lg:col-span-2 bg-slate-900/50 rounded-2xl p-6 border border-slate-800">
      <h3 class="text-xl font-bold mb-6 flex items-center gap-3">
        <i data-lucide="calculator" class="w-6 h-6 text-blue-400"></i>
        Package Projection
      </h3>
      <div class="space-y-6">
        <div>
          <label class="block text-sm font-medium text-slate-300 mb-2">Select Package</label>
          <select class="w-full px-4 py-3 rounded-xl bg-slate-800 border border-slate-700 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none">
            <% packages.forEach(plan => { %>
            <option value="<%= plan.price %>"><%= plan.name %> - $<%= plan.price.toLocaleString() %> (<%= plan.profit %> weekly)</option>
            <% }) %>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="bg-slate-800/50 p-4 rounded-xl">
            <p class="text-sm text-slate-400">Projected Weekly</p>
            <p class="text-2xl font-bold text-emerald-400" id="weeklyReturn">$25.00</p>
          </div>
          <div class="bg-slate-800/50 p-4 rounded-xl">
            <p class="text-sm text-slate-400">Projected Monthly</p>
            <p class="text-2xl font-bold text-blue-400" id="monthlyReturn">$108.33</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Why Invest With Us -->
    <div class="bg-gradient-to-br from-blue-900/20 to-cyan-900/20 rounded-2xl p-6 border border-blue-800/30">
      <h3 class="text-xl font-bold mb-6 flex items-center gap-3">
        <i data-lucide="shield-check" class="w-6 h-6 text-blue-400"></i>
        Why Choose Our Packages?
      </h3>
      <ul class="space-y-4">
        <li class="flex items-start gap-3">
          <i data-lucide="check-circle" class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0"></i>
          <div>
            <p class="font-medium text-slate-200">Clear Package Terms</p>
            <p class="text-sm text-slate-400">Each package shows its projected weekly rate before you subscribe</p>
          </div>
        </li>
        <li class="flex items-start gap-3">
          <i data-lucide="lock" class="w-5 h-5 text-blue-400 mt-0.5 flex-shrink-0"></i>
          <div>
            <p class="font-medium text-slate-200">Secure Platform</p>
            <p class="text-sm text-slate-400">Bank-level security and encryption for all transactions</p>
          </div>
        </li>
        <li class="flex items-start gap-3">
          <i data-lucide="users" class="w-5 h-5 text-purple-400 mt-0.5 flex-shrink-0"></i>
          <div>
            <p class="font-medium text-slate-200">Strategy Access</p>
            <p class="text-sm text-slate-400">Packages unlock platform access and structured trading benefits</p>
          </div>
        </li>
      </ul>
    </div>
  </div>

  <!-- FAQ -->
  <div class="mt-12">
    <h3 class="text-2xl font-bold mb-8 text-center">Frequently Asked Questions</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-slate-900/30 p-6 rounded-xl">
        <h4 class="font-bold mb-2 flex items-center gap-2"><i data-lucide="help-circle" class="w-5 h-5 text-blue-400"></i> How are returns calculated?</h4>
        <p class="text-sm text-slate-400">Projected values are calculated from the package amount and displayed rate. Actual account outcomes depend on market activity and platform rules.</p>
      </div>
      <div class="bg-slate-900/30 p-6 rounded-xl">
        <h4 class="font-bold mb-2 flex items-center gap-2"><i data-lucide="refresh-cw" class="w-5 h-5 text-blue-400"></i> Can I upgrade my package?</h4>
        <p class="text-sm text-slate-400">Yes! You can upgrade at any time. You can subscribe to another package when your total deposit can cover the package price.</p>
      </div>
    </div>
  </div>
</main>

<!-- Initialize Icons & Calculator -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Initialize Lucide icons
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }

    const packages = <%- JSON.stringify(packages.map(p => ({ name: p.name, price: p.price, profit: String(p.profit).replace(/ weekly/i, '') }))) %>;
    // Package Projection
    const select = document.querySelector('select');
    const weeklyEl = document.getElementById('weeklyReturn');
    const monthlyEl = document.getElementById('monthlyReturn');
    
    function updateCalculator() {
      const price = parseFloat(select.value);
      const plan = packages.find(p => p.price === price);
      if (!plan) return;
      
      const weeklyReturn = price * (parseFloat(plan.profit) / 100);
      const monthlyReturn = weeklyReturn * 4.33; // Average weeks per month
      
      weeklyEl.textContent = '$' + weeklyReturn.toFixed(2);
      monthlyEl.textContent = '$' + monthlyReturn.toFixed(2);
    }
    
    if (select) {
      select.addEventListener('change', updateCalculator);
      updateCalculator(); // Initial calculation
    }
  });
</script>

<!-- Toast Notifications -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<% if (toast) { %>
<script>
  Swal.fire({
    icon: '<%= toast.type %>',
    title: '<%= toast.message %>',
    toast: true,
    position: 'top-end',
    showConfirmButton: false,
    timer: 3000,
    timerProgressBar: true,
    background: '#0f172a',
    color: '#f8fafc',
    customClass: {
      popup: 'border border-slate-700'
    }
  });
</script>
<% } %>

  <%- include('mobile-downbar') %>
</body>
</html>
