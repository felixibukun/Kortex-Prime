<!DOCTYPE html>
<html lang="en" class="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Stocks Marketplace</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
<script>
tailwind.config = {
darkMode: 'class',
theme: {
extend: {
fontFamily: { sans: ['Inter', 'sans-serif'] },
colors: { primary: { 500: '#6366F1', 600: '#4F46E5' } }
}
}
}
</script>
<link rel="stylesheet" href="/css/premium-ui.css">
</head>

<body class="bg-slate-950 text-white font-sans">
<header class="h-16 border-b border-slate-800 bg-slate-950/80 backdrop-blur-xl flex items-center">
<div class="w-full max-w-6xl mx-auto px-4 flex items-center justify-between">
<div class="flex items-center gap-3">
<button onclick="history.back()" class="h-8 w-8 rounded-xl bg-slate-900 border border-slate-700 flex items-center justify-center">
<i data-lucide="arrow-left" class="w-4 h-4"></i>
</button>
<div>
<p class="text-xs text-slate-400">Stocks</p>
<p class="text-sm font-semibold text-slate-100">Stocks Marketplace</p>
</div>
</div>
<a href="/dashboard" class="text-xs text-slate-300 hover:text-white">Back to dashboard</a>
</div>
</header>

<main class="max-w-6xl mx-auto px-4 py-8 space-y-6">

<section class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
<div>
<p class="text-sm font-semibold text-slate-100">Select a stock and buy units</p>
<p class="text-xs text-slate-400 mt-1">Prices move in real time</p>
</div>

<div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto">
<div class="relative flex-1">
<input id="searchInput" type="text" placeholder="Search by name or symbol" class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-xs focus:outline-none focus:border-primary-600 focus:ring-opacity-50 pr-9">
<div class="absolute inset-y-0 right-3 flex items-center pointer-events-none">
<i data-lucide="search" class="w-3 h-3 text-slate-500"></i>
</div>
</div>

<div class="flex items-center gap-2 text-[11px] bg-slate-900 border border-slate-800 rounded-xl px-2 py-1">
<span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
<span class="text-slate-300">Market active</span>
</div>
</div>
</section>

<section class="flex flex-wrap gap-2 text-xs">
<button data-filter="all" class="stock-filter px-3 py-1.5 rounded-full bg-primary-600 text-white font-semibold">All</button>
<button data-filter="tech" class="stock-filter px-3 py-1.5 rounded-full bg-slate-900 border border-slate-700 text-slate-300">Tech</button>
<button data-filter="growth" class="stock-filter px-3 py-1.5 rounded-full bg-slate-900 border border-slate-700 text-slate-300">Growth</button>
<button data-filter="value" class="stock-filter px-3 py-1.5 rounded-full bg-slate-900 border border-slate-700 text-slate-300">Value</button>
</section>

<section id="stocksGrid" class="grid grid-cols-1 md:grid-cols-2 gap-5">

<% stocks.forEach(stock => { %>
<div class="stock-card group bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-xl relative overflow-hidden transition-transform duration-200 hover:-translate-y-1 hover:shadow-2xl"
data-name="<%= stock.name.toLowerCase() %>"
data-symbol="<%= stock.symbol.toLowerCase() %>"
data-tags="tech growth"
data-stock-id="<%= stock.id %>"
data-price="<%= Number(stock.price).toFixed(2) %>">

<div class="pointer-events-none absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
<div class="absolute -top-10 -right-16 w-40 h-40 bg-primary-600/20 blur-3xl"></div>
<div class="absolute -bottom-10 -left-16 w-40 h-40 bg-emerald-500/10 blur-3xl"></div>
</div>

<div class="relative flex flex-col gap-4">
<div class="flex items-start justify-between gap-3">
<div class="flex items-center gap-3">
<img src="https://logo.clearbit.com/<%= stock.name.toLowerCase() %>.com"
onerror="this.src='https://ui-avatars.com/api/?name=<%= stock.symbol %>&background=1e293b&color=fff&size=64'"
class="h-9 w-9 rounded-full bg-slate-800 border border-slate-700">

<div>
<p class="text-sm font-semibold text-slate-100 flex items-center gap-2">
<span><%= stock.name %></span>
<span class="text-[11px] px-2 py-0.5 rounded-full bg-slate-800 text-slate-300"><%= stock.symbol %></span>
</p>
<p class="text-[11px] text-slate-500 mt-1">United States High liquidity</p>
</div>
</div>

<div class="flex flex-col items-end gap-1">
<span class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 market-mood">Bullish</span>
<span class="text-[10px] text-slate-500 flex items-center gap-1"><span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>Live</span>
</div>
</div>

<div class="flex items-center justify-between gap-4">
<div>
<p class="text-xs text-slate-400">Price</p>
<div class="flex items-baseline gap-2 mt-1">
<p class="text-xl font-semibold text-slate-50 price-text">$<span class="price-value"><%= Number(stock.price).toFixed(2) %></span></p>
<span class="text-[11px] font-medium change-badge text-emerald-400">+0.00%</span>
</div>
<p class="text-[11px] text-slate-500 mt-1">Market cap: <span class="text-slate-300">$<%= stock.marketCap %></span></p>
</div>

<div class="w-28 h-20 bg-slate-900/80 rounded-xl border border-slate-800 flex items-center justify-center">
<canvas class="candle-chart" data-stock-id="<%= stock.id %>" width="110" height="70"></canvas>
</div>
</div>

<form action="/stocks/buy" method="POST" class="space-y-3 relative z-10">
<input type="hidden" name="stockId" value="<%= stock.id %>">

<div class="flex flex-col gap-2">
<label class="text-xs text-slate-400">Enter quantity</label>

<div class="flex gap-2">
<input type="number" name="quantity" min="1" placeholder="0" class="w-full px-3 py-2 rounded-xl bg-slate-950/80 border border-slate-700 text-xs focus:outline-none focus:border-primary-600 focus:ring-1 focus:ring-primary-600">

<button type="submit" class="px-4 py-2 rounded-xl bg-primary-600 text-[11px] font-semibold flex items-center justify-center gap-1 hover:bg-primary-500 transition-colors">
<i data-lucide="shopping-bag" class="w-3 h-3"></i>
<span>Buy Stock</span>
</button>
</div>

<p class="text-[11px] text-slate-500">Market order Instant execution</p>
</div>
</form>

</div>
</div>
<% }) %>

</section>
</main>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
document.addEventListener('DOMContentLoaded', function () {
if (typeof lucide !== 'undefined') lucide.createIcons()

const cards = Array.from(document.querySelectorAll('.stock-card'))
const searchInput = document.getElementById('searchInput')
const filterButtons = Array.from(document.querySelectorAll('.stock-filter'))

if (searchInput) {
searchInput.addEventListener('input', function () {
const q = this.value.toLowerCase().trim()
cards.forEach(card => {
const name = card.dataset.name
const symbol = card.dataset.symbol
card.style.display = name.includes(q) || symbol.includes(q) ? '' : 'none'
})
})
}

filterButtons.forEach(btn => {
btn.addEventListener('click', () => {
const tag = btn.dataset.filter
filterButtons.forEach(b => {
b.classList.remove('bg-primary-600', 'text-white')
b.classList.add('bg-slate-900', 'border', 'border-slate-700', 'text-slate-300')
})
btn.classList.add('bg-primary-600', 'text-white')

cards.forEach(card => {
const tags = (card.dataset.tags || '').split(' ')
card.style.display = tag === 'all' || tags.includes(tag) ? '' : 'none'
})
})
})

function simulateTick() {
cards.forEach(card => {
const priceSpan = card.querySelector('.price-value')
const badge = card.querySelector('.change-badge')
const mood = card.querySelector('.market-mood')

let current = Number(card.dataset.price || priceSpan.textContent)
if (!current) return

const maxChange = 0.0025
const deltaPercent = (Math.random() * 2 * maxChange) - maxChange
const newPrice = current * (1 + deltaPercent)

const rounded = newPrice.toFixed(2)
const pct = (deltaPercent * 100).toFixed(2)

card.dataset.price = rounded
priceSpan.textContent = rounded

const up = deltaPercent > 0

badge.textContent = (up ? '+' : '') + pct + '%'
badge.classList.remove('text-emerald-400', 'text-red-400')
badge.classList.add(up ? 'text-emerald-400' : 'text-red-400')

mood.textContent = up ? 'Bullish' : 'Bearish'
mood.classList.remove('text-emerald-400', 'text-red-400')
mood.classList.add(up ? 'text-emerald-400' : 'text-red-400')

card.classList.remove('ring-1', 'ring-emerald-500/40', 'ring-red-500/40')
void card.offsetWidth
card.classList.add('ring-1', up ? 'ring-emerald-500/40' : 'ring-red-500/40')

setTimeout(() => {
card.classList.remove('ring-1', 'ring-emerald-500/40', 'ring-red-500/40')
}, 400)
})
}

setInterval(simulateTick, 5000)
})
</script>

<script>
document.addEventListener('DOMContentLoaded', () => {
const charts = document.querySelectorAll('.candle-chart')

charts.forEach(canvas => {
const ctx = canvas.getContext('2d')
const w = canvas.width
const h = canvas.height

function rand(min, max) {
return Math.floor(Math.random() * (max - min) + min)
}

const candles = 8
const candleWidth = w / candles - 4
let x = 2

for (let i = 0; i < candles; i++) {
const open = rand(20, 60)
const close = rand(20, 60)
const high = Math.max(open, close) + rand(5, 15)
const low = Math.min(open, close) - rand(5, 15)

const green = close > open
ctx.strokeStyle = green ? 'rgb(16,185,129)' : 'rgb(239,68,68)'
ctx.fillStyle = green ? 'rgb(16,185,129)' : 'rgb(239,68,68)'

ctx.beginPath()
ctx.moveTo(x + candleWidth / 2, h - high)
ctx.lineTo(x + candleWidth / 2, h - low)
ctx.stroke()

ctx.fillRect(
x,
h - Math.max(open, close),
candleWidth,
Math.abs(open - close)
)

x += candleWidth + 4
}
})
})
</script>

<% if (toast) { %>
<script>
Swal.fire({
icon: '<%= toast.type %>',
title: '<%= toast.message %>',
toast: true,
position: 'top',
showConfirmButton: false,
timer: 2500
})
</script>
<% } %>

  <%- include('mobile-downbar') %>
</body>
</html>
