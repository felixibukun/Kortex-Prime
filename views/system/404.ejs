      color: #fff;
      font-family: Inter, Arial, sans-serif;
    }
    .wrap {
      width: min(560px, 100%);
      text-align: center;
      padding: 34px 22px;
    }
    .brand {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 34px;
      color: #fff;
      text-decoration: none;
    }
    .brand img {
      width: 44px;
      height: 44px;
      object-fit: contain;
    }
    .brand strong {
      display: block;
      font-size: 16px;
      letter-spacing: 0.08em;
    }
    .brand span {
      display: block;
      color: #8da0b6;
      font-size: 10px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      text-align: left;
    }
    .code {
      font-size: clamp(72px, 18vw, 128px);
      line-height: 0.9;
      font-weight: 900;
      color: #49bdff;
      text-shadow: 0 0 35px rgba(0, 144, 255, 0.32);
    }
    h1 {
      margin-top: 18px;
      font-size: clamp(28px, 7vw, 44px);
      line-height: 1.05;
    }
    p {
      max-width: 440px;
      margin: 16px auto 28px;
      color: #9fb0c2;
      font-size: 15px;
      line-height: 1.6;
    }
    .actions {
      display: flex;
      justify-content: center;
      gap: 12px;
      flex-wrap: wrap;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 44px;
      padding: 0 18px;
      border-radius: 10px;
      color: #fff;
      text-decoration: none;
      font-weight: 700;
      border: 1px solid rgba(255,255,255,0.12);
      background: rgba(255,255,255,0.05);
    }
    .btn.primary {
      color: #00101d;
      border: 0;
      background: linear-gradient(135deg, #0090ff, #00c8ff);
