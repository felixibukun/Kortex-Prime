  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 24px;
      background:
        radial-gradient(circle at 20% 10%, rgba(0, 200, 255, 0.14), transparent 30%),
        radial-gradient(circle at 80% 80%, rgba(0, 144, 255, 0.10), transparent 34%),
