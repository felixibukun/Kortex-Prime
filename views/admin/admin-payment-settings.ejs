<!DOCTYPE html>
<html>
<head>
  <title>Payment Settings</title>
  <script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="/css/premium-ui.css">
</head>
<body class="bg-slate-950 text-white">

<div class="flex">

  <%- include('admin-sidebar') %>

  <main class="flex-1 p-10">

    <h1 class="text-2xl font-semibold mb-6">Payment Settings</h1>

    <% if (methods.length === 0) { %>

      <p class="text-slate-400">No deposit methods added yet.</p>

    <% } else { %>

      <% methods.forEach(m => { %>
        <div class="mb-6">
          <label class="block mb-1 font-semibold"><%= m.name %></label>
          <input 
            type="text"
            value="<%= m.details %>"
            class="w-full px-3 py-2 bg-slate-800 border border-slate-700 rounded"
            readonly
          >
        </div>
      <% }) %>

    <% } %>

  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<% if (toast) { %>
<script>
  Swal.fire({
    icon: '<%= toast.type %>',
    title: '<%= toast.message %>',
    toast: true,
    position: 'top',
    showConfirmButton: false,
    timer: 2500
  })
</script>
<% } %>

</body>
</html>
