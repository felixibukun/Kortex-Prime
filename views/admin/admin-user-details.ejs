<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>User Details - <%= user.username %></title>
  <script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="/css/premium-ui.css">
</head>

<body class="bg-gray-900 text-white min-h-screen">
<%- include('admin-sidebar') %>
  <header class="w-full bg-gray-800 p-4 flex items-center justify-between shadow">
    <div>
      <h1 class="text-xl font-semibold">User Details</h1>
      <p class="text-sm text-gray-400"><%= user.username %></p>
    </div>
    <a href="/admin/users" class="bg-blue-600 px-4 py-2 rounded">Back</a>
  </header>

  <main class="p-4 sm:p-6 max-w-6xl mx-auto space-y-6">
    <section class="grid lg:grid-cols-3 gap-4">
      <div class="lg:col-span-2 bg-gray-800 border border-gray-700 rounded-xl p-5">
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
          <div>
            <h2 class="text-2xl font-semibold"><%= user.name || user.username %></h2>
            <p class="text-gray-400 text-sm mt-1"><%= user.email %></p>
          </div>
          <form action="/admin/user/<%= user.id %>/impersonate" method="POST">
            <button class="bg-emerald-600 hover:bg-emerald-700 px-4 py-2 rounded font-semibold">
              Enter User Account
            </button>
          </form>
        </div>

        <div class="grid sm:grid-cols-2 gap-4 mt-6 text-sm">
          <div class="bg-gray-900 rounded-lg p-4">
            <p class="text-gray-400">Username</p>
            <p class="font-semibold mt-1"><%= user.username %></p>
          </div>
          <div class="bg-gray-900 rounded-lg p-4">
            <p class="text-gray-400">Email</p>
            <p class="font-semibold mt-1"><%= user.email %></p>
          </div>
          <div class="bg-gray-900 rounded-lg p-4">
            <p class="text-gray-400">Phone</p>
            <p class="font-semibold mt-1"><%= user.phone || 'N/A' %></p>
          </div>
          <div class="bg-gray-900 rounded-lg p-4">
            <p class="text-gray-400">Country</p>
            <p class="font-semibold mt-1"><%= user.country || 'N/A' %></p>
          </div>
          <div class="bg-gray-900 rounded-lg p-4">
            <p class="text-gray-400">KYC</p>
            <p class="font-semibold mt-1"><%= user.kycStatus || (user.verified ? 'Verified' : 'Not Verified') %></p>
          </div>
          <div class="bg-gray-900 rounded-lg p-4">
            <p class="text-gray-400">Created</p>
            <p class="font-semibold mt-1"><%= user.createdAt ? new Date(user.createdAt).toLocaleString() : 'N/A' %></p>
          </div>
        </div>
      </div>

      <div class="bg-gray-800 border border-gray-700 rounded-xl p-5">
        <h3 class="font-semibold mb-4">Login Activity</h3>
        <div class="space-y-3 text-sm">
          <div class="flex justify-between gap-4">
            <span class="text-gray-400">Last login</span>
            <span class="text-right"><%= user.lastLoginAt ? new Date(user.lastLoginAt).toLocaleString() : 'Never' %></span>
          </div>
          <div class="flex justify-between gap-4">
            <span class="text-gray-400">Last IP</span>
            <span class="text-right"><%= user.lastLoginIp || 'No IP recorded' %></span>
          </div>
          <div class="flex justify-between gap-4">
            <span class="text-gray-400">Login count</span>
            <span><%= Number(user.loginCount || 0) %></span>
          </div>
          <div class="flex justify-between gap-4">
            <span class="text-gray-400">Password updated</span>
            <span class="text-right"><%= user.passwordUpdatedAt ? new Date(user.passwordUpdatedAt).toLocaleString() : 'N/A' %></span>
          </div>
        </div>
        <p class="text-xs text-gray-500 mt-4">Stored passwords are hashed and cannot be viewed as plaintext.</p>
      </div>
    </section>

    <section class="grid lg:grid-cols-3 gap-4">
      <div class="bg-gray-800 border border-gray-700 rounded-xl p-5">
        <h3 class="font-semibold mb-4">Financials</h3>
        <div class="space-y-3 text-sm">
          <div class="flex justify-between"><span class="text-gray-400">Balance</span><span>$<%= Number(financialStats.totalBalance || 0).toFixed(2) %></span></div>
          <div class="flex justify-between"><span class="text-gray-400">Deposit</span><span>$<%= Number(financialStats.totalDeposit || 0).toFixed(2) %></span></div>
          <div class="flex justify-between"><span class="text-gray-400">Profit</span><span>$<%= Number(financialStats.totalProfit || 0).toFixed(2) %></span></div>
          <div class="flex justify-between"><span class="text-gray-400">Withdrawal</span><span>$<%= Number(financialStats.totalWithdrawal || 0).toFixed(2) %></span></div>
        </div>
        <a href="/admin/user/<%= user.id %>/balance" class="block text-center mt-5 bg-yellow-600 hover:bg-yellow-700 px-4 py-2 rounded">
          Edit Balance
        </a>
      </div>

      <div class="bg-gray-800 border border-gray-700 rounded-xl p-5">
        <h3 class="font-semibold mb-4">Records</h3>
        <div class="grid grid-cols-2 gap-3 text-sm">
          <div class="bg-gray-900 rounded-lg p-3"><p class="text-gray-400">Trades</p><p class="text-xl font-semibold"><%= trades.length %></p></div>
          <div class="bg-gray-900 rounded-lg p-3"><p class="text-gray-400">Holdings</p><p class="text-xl font-semibold"><%= holdings.length %></p></div>
          <div class="bg-gray-900 rounded-lg p-3"><p class="text-gray-400">Deposits</p><p class="text-xl font-semibold"><%= deposits.length %></p></div>
          <div class="bg-gray-900 rounded-lg p-3"><p class="text-gray-400">Withdrawals</p><p class="text-xl font-semibold"><%= withdrawals.length %></p></div>
          <div class="bg-gray-900 rounded-lg p-3"><p class="text-gray-400">KYC</p><p class="text-xl font-semibold"><%= kyc.length %></p></div>
          <div class="bg-gray-900 rounded-lg p-3"><p class="text-gray-400">Packages</p><p class="text-xl font-semibold"><%= subscriptions.length %></p></div>
        </div>
      </div>

      <div class="bg-gray-800 border border-gray-700 rounded-xl p-5">
        <h3 class="font-semibold mb-4">Set New Password</h3>
        <form action="/admin/user/<%= user.id %>/password" method="POST" class="space-y-3">
          <div>
            <label class="block text-sm text-gray-400 mb-1">New password</label>
            <input type="text" name="password" minlength="6" required class="w-full p-3 rounded bg-gray-900 border border-gray-700 outline-none focus:border-blue-500" placeholder="Enter new password">
          </div>
          <button class="w-full bg-blue-600 hover:bg-blue-700 px-4 py-2 rounded font-semibold">
            Update Password
          </button>
        </form>
        <p class="text-xs text-gray-500 mt-3">This sets a new login password. Existing plaintext passwords cannot be recovered.</p>
      </div>
    </section>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <% if (toast) { %>
  <script>
    Swal.fire({
      icon: '<%= toast.type %>',
      title: '<%= toast.message %>',
      toast: true,
      position: 'top',
      showConfirmButton: false,
      timer: 2500
    })
  </script>
  <% } %>
</body>
</html>
