<style>
:root {
    --kortex-primary: #0066FF;
    --kortex-secondary: #00D4FF;
    --kortex-accent: #7B3FE4;
    --kortex-dark: #0A0F2B;
    --kortex-darker: #070B1F;
    --kortex-card: #111837;
    --kortex-green: #00C853;
    --kortex-red: #FF3B30;
    --kortex-yellow: #FFCC00;
    --kortex-orange: #FF6B00;
}

body {
    background: var(--kortex-dark);
    color: #FFFFFF !important;
    font-family: 'Inter', sans-serif;
    overflow-x: hidden;
}

/* Force white text on all elements */
h1, h2, h3, h4, h5, h6,
p, span, div, a:not(.btn),
li, td, th, small, strong {
    color: #FFFFFF !important;
}

/* Trading Terminal Style Header */
#trading-header {
    background: var(--kortex-darker);
    border-bottom: 1px solid rgba(255,255,255,0.05);
    padding: 8px 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
}

.market-ticker {
    white-space: nowrap;
    overflow: hidden;
}

.ticker-item {
    display: inline-block;
    padding: 0 20px;
    border-right: 1px solid rgba(255,255,255,0.1);
    color: #FFFFFF;
}

.ticker-item:last-child {
    border-right: none;
}

.ticker-item .price {
    color: #FFFFFF;
    font-weight: 600;
}

.ticker-item .change {
    font-weight: 600;
    margin-left: 5px;
}

.change.positive { color: var(--kortex-green) !important; }
.change.negative { color: var(--kortex-red) !important; }

/* Enhanced Navigation */
.navbar {
    background: rgba(10, 15, 43, 0.95);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(0, 102, 255, 0.1);
    padding: 15px 0;
}

.nav-link {
    color: #FFFFFF !important;
    font-weight: 500;
    margin: 0 8px;
    padding: 8px 16px !important;
    border-radius: 6px;
    transition: all 0.3s ease;
}

.nav-link:hover {
    background: rgba(0, 102, 255, 0.1);
}

.nav-link.active {
    background: rgba(0, 102, 255, 0.15);
}

/* About Hero */
.about-hero {
    background: linear-gradient(135deg, rgba(10,15,43,0.95) 0%, rgba(7,11,31,0.98) 100%);
    padding: 120px 0 80px;
    position: relative;
    overflow: hidden;
}

.about-hero::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle at center, rgba(0,102,255,0.1) 0%, transparent 70%);
}

.glow-text {
    background: linear-gradient(135deg, var(--kortex-primary), var(--kortex-secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

/* Mission Section */
.mission-section {
    background: var(--kortex-darker);
    position: relative;
}

.mission-card {
    background: var(--kortex-card);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 16px;
    padding: 40px;
    transition: all 0.3s ease;
    height: 100%;
}

.mission-card:hover {
    transform: translateY(-5px);
    border-color: rgba(0,102,255,0.3);
    box-shadow: 0 20px 40px rgba(0,102,255,0.15);
}

.mission-icon {
    width: 80px;
    height: 80px;
    background: linear-gradient(135deg, var(--kortex-primary), var(--kortex-secondary));
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 25px;
}

.mission-icon i {
    font-size: 36px;
    color: white;
}

/* Values Section */
.values-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 30px;
}

.value-card {
    background: var(--kortex-card);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 12px;
    padding: 30px;
    text-align: center;
}

.value-number {
    width: 50px;
    height: 50px;
    background: linear-gradient(135deg, var(--kortex-primary), var(--kortex-accent));
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
    font-weight: bold;
    font-size: 20px;
}

/* Timeline */
.timeline {
    position: relative;
    padding-left: 40px;
}

.timeline::before {
    content: '';
    position: absolute;
    left: 15px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(to bottom, var(--kortex-primary), var(--kortex-secondary));
}

.timeline-item {
    position: relative;
    margin-bottom: 40px;
}

.timeline-dot {
    position: absolute;
    left: -45px;
    top: 5px;
    width: 24px;
    height: 24px;
    background: var(--kortex-primary);
    border-radius: 50%;
    border: 4px solid var(--kortex-darker);
}

.timeline-year {
    color: var(--kortex-primary);
    font-weight: 600;
    margin-bottom: 5px;
}

/* Team Section */
.team-card {
    background: var(--kortex-card);
    border-radius: 16px;
    overflow: hidden;
    transition: all 0.3s ease;
}

.team-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 25px 50px rgba(0,102,255,0.2);
}

.team-img {
    width: 100%;
    height: 250px;
    background: linear-gradient(135deg, var(--kortex-primary), var(--kortex-secondary));
    position: relative;
    overflow: hidden;
}

.team-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.team-info {
    padding: 25px;
}

.team-social {
    display: flex;
    gap: 10px;
    margin-top: 15px;
}

.team-social a {
    width: 36px;
    height: 36px;
    background: rgba(255,255,255,0.05);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
}

.team-social a:hover {
    background: var(--kortex-primary);
    transform: translateY(-3px);
}

/* Stats */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 30px;
    text-align: center;
}

.stat-item {
    padding: 30px;
    background: var(--kortex-card);
    border-radius: 12px;
    border: 1px solid rgba(0,102,255,0.1);
}

.stat-number {
    font-size: 3rem;
    font-weight: 800;
    background: linear-gradient(135deg, var(--kortex-primary), var(--kortex-secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
    margin-bottom: 10px;
}

/* Buttons */
.btn-primary {
    background: linear-gradient(135deg, var(--kortex-primary), var(--kortex-secondary));
    border: none;
    padding: 12px 30px;
    border-radius: 10px;
    font-weight: 600;
    transition: all 0.3s ease;
    color: white !important;
}

.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(0,102,255,0.3);
}

.btn-outline-light {
    border: 2px solid rgba(255,255,255,0.2);
    background: transparent;
    color: white !important;
    padding: 12px 30px;
    border-radius: 10px;
    font-weight: 600;
    transition: all 0.3s ease;
}

.btn-outline-light:hover {
    border-color: var(--kortex-primary);
    background: rgba(0,102,255,0.1);
}

/* Footer */
.footer {
    background: var(--kortex-darker);
    border-top: 1px solid rgba(255,255,255,0.05);
}

.footer-links a {
    color: #B0B5C2 !important;
    text-decoration: none;
    transition: color 0.3s ease;
}

.footer-links a:hover {
    color: var(--kortex-primary) !important;
}

.legal-notice {
    background: rgba(255, 59, 48, 0.1);
    border: 1px solid rgba(255, 59, 48, 0.3);
    border-radius: 8px;
    padding: 15px;
    margin-top: 30px;
    color: #FFFFFF;
}

/* Animations */
@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.animate-in {
    animation: slideIn 0.6s ease forwards;
}

/* Responsive */
@media (max-width: 768px) {
    .display-3 {
        font-size: 2.5rem;
    }
    .about-hero {
        padding: 80px 0 40px;
    }
    .timeline {
        padding-left: 30px;
    }
    .timeline::before {
        left: 10px;
    }
    .timeline-dot {
        left: -35px;
    }
}
</style>
