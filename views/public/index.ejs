function filterNews(btn, topic) {
  document.querySelectorAll('.news-filter').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  currentTopic = topic;
  loadNews(topic);
}

function loadNews(topic) {
  const grid = document.getElementById('newsGrid');
  const lastUpdate = document.getElementById('lastUpdate');
  if (!grid) return;

  grid.innerHTML = `<div style="grid-column:1/-1;text-align:center;padding:60px;color:var(--muted);">
    <i class="fas fa-circle-notch fa-spin fa-2x" style="margin-bottom:16px;display:block;color:var(--blue2);"></i>Loading news…</div>`;

  setTimeout(() => {
    const articles = fallbackNews[topic] || fallbackNews.crypto;
    grid.innerHTML = '';
    articles.forEach((a, i) => {
      const img = cryptoImages[i % cryptoImages.length];
      grid.innerHTML += `
        <div class="ncard reveal">
          <div class="ncard-img">
            <img src="${img}" alt="${a.title}" loading="lazy">
            <div class="ncard-tag">${a.tag}</div>
          </div>
          <div class="ncard-body">
            <div class="ncard-meta">
              <span><i class="far fa-clock"></i> ${a.date}</span>
              <span><i class="fas fa-newspaper"></i> Crypto News</span>
            </div>
            <div class="ncard-title">${a.title}</div>
            <p class="ncard-excerpt">${a.desc}</p>
            <div class="ncard-link">Read Full Article <i class="fas fa-arrow-right"></i></div>
          </div>
        </div>`;
    });

    document.querySelectorAll('#newsGrid .reveal').forEach(el => observer.observe(el));

    if (lastUpdate) {
      const now = new Date();
      lastUpdate.innerHTML = `<i class="fas fa-sync-alt" style="color:var(--blue2)"></i> Updated ${now.toLocaleTimeString()}`;
    }
  }, 600);

  // Try real API
  fetch(`https://min-api.cryptocompare.com/data/v2/news/?lang=EN&categories=${topic}&limit=6`)
    .then(r => r.json())
    .then(data => {
      if (!data.Data || data.Data.length === 0) return;
      const articles = data.Data.slice(0, 6);
      grid.innerHTML = '';
      articles.forEach((a, i) => {
        const img = a.imageurl || cryptoImages[i % cryptoImages.length];
        const date = new Date(a.published_on * 1000);
        const ago = Math.floor((Date.now() - date) / 3600000);
        const tag = topic === 'bitcoin' ? 'BITCOIN' : topic === 'ethereum' ? 'ETHEREUM' : topic === 'defi' ? 'DEFI' : 'MARKET';
        grid.innerHTML += `
          <div class="ncard reveal">
            <div class="ncard-img">
              <img src="${img}" alt="${a.title.substring(0,60)}" loading="lazy" onerror="this.src='${cryptoImages[i%cryptoImages.length]}'">
              <div class="ncard-tag">${tag}</div>
            </div>
            <div class="ncard-body">
              <div class="ncard-meta">
                <span><i class="far fa-clock"></i> ${ago}h ago</span>
                <span><i class="fas fa-newspaper"></i> ${a.source_info?.name || 'Crypto News'}</span>
              </div>
              <div class="ncard-title">${a.title.substring(0, 80)}${a.title.length > 80 ? '…' : ''}</div>
              <p class="ncard-excerpt">${(a.body || '').substring(0, 110)}…</p>
              <a href="${a.url}" target="_blank" rel="noopener" class="ncard-link">Read Full Article <i class="fas fa-arrow-right"></i></a>
            </div>
          </div>`;
      });
      document.querySelectorAll('#newsGrid .reveal').forEach(el => observer.observe(el));
    })
    .catch(() => {}); // fallback already shown
}

// Init news
