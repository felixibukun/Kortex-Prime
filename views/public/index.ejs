<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Kortex Prime — Institutional Trading Platform</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Professional trading platform for Forex, Crypto, Indices & Commodities.">

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

<!-- Favicon -->
<link rel="icon" type="image/png" href="/img/favicon-32.png?v=20260509">
<link rel="shortcut icon" href="/favicon.ico?v=20260509">
<link rel="apple-touch-icon" href="/img/apple-touch-icon.png?v=20260509">

<!-- Icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<style>
/* ============================================================
   DESIGN TOKENS
   ============================================================ */
:root {
  --black:    #030508;
  --surface:  #080d16;
  --card:     #0d1420;
  --card2:    #111b2b;
  --border:   rgba(255,255,255,0.07);
  --border2:  rgba(0,176,255,0.2);
  --blue:     #0090ff;
  --blue2:    #00c8ff;
  --cyan:     #00ffd5;
  --green:    #00e676;
  --red:      #ff3d5a;
  --gold:     #ffc040;
  --white:    #ffffff;
  --muted:    #8899aa;
  --muted2:   #4a5a6e;
  --font-head: 'Inter', sans-serif;
  --font-body: 'Inter', sans-serif;
  --font-mono: 'Inter', sans-serif;
}

/* ============================================================
   RESET & BASE
   ============================================================ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html {
  scroll-behavior: smooth;
  font-size: 16px;
  overflow-x: hidden;
  width: 100%;
}

body {
  background: var(--black);
  color: var(--white);
  font-family: var(--font-body);
  overflow-x: hidden;
  width: 100%;
  max-width: 100vw;
  -webkit-font-smoothing: antialiased;
}

a { text-decoration: none; color: inherit; }
img { display: block; max-width: 100%; }
button { cursor: pointer; border: none; background: none; }

/* ============================================================
   NOISE TEXTURE OVERLAY
   ============================================================ */
body::before {
  content: '';
  position: fixed;
  inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
  pointer-events: none;
  z-index: 9999;
  opacity: 0.4;
}

/* ============================================================
   CANVAS PARTICLES
   ============================================================ */
#particles-canvas {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  opacity: 0.45;
}

/* ============================================================
   TICKER BAR
   ============================================================ */
.ticker-bar {
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  height: 36px;
  display: flex;
  align-items: center;
  overflow: hidden;
  position: relative;
  z-index: 100;
}

.ticker-track {
  display: flex;
  gap: 0;
  animation: ticker-scroll 35s linear infinite;
  white-space: nowrap;
}

.ticker-track:hover { animation-play-state: paused; }

@keyframes ticker-scroll {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}

.ticker-item {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 0 24px;
  font-family: var(--font-mono);
  font-size: 11px;
  border-right: 1px solid var(--border);
}

.ticker-item .sym { color: var(--muted); }
.ticker-item .prc { color: var(--white); font-weight: 500; }
.ticker-item .chg { font-weight: 600; }
.ticker-item .chg.up   { color: var(--green); }
.ticker-item .chg.dn   { color: var(--red); }

.ticker-label {
  background: var(--blue);
  color: #000;
  font-family: var(--font-mono);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.08em;
  padding: 0 14px;
  height: 100%;
  display: flex;
  align-items: center;
  flex-shrink: 0;
  z-index: 2;
}

/* ============================================================
   NAVIGATION
   ============================================================ */
.nav {
  position: sticky;
  top: 0;
  z-index: 500;
  background: rgba(3,5,8,0.82);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border-bottom: 1px solid var(--border);
  height: 68px;
  display: flex;
  align-items: center;
}

.nav-inner {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 32px;
  width: 100%;
  display: flex;
  align-items: center;
  gap: 48px;
}

.nav-logo {
  display: flex;
  align-items: center;
  gap: 11px;
  flex-shrink: 0;
}

.nav-logo-mark {
  width: 42px;
  height: 42px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.04);
  border: 1px solid var(--border);
  padding: 4px;
  overflow: hidden;
}

.site-logo {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}

.nav-logo-text {
  display: flex;
  flex-direction: column;
  line-height: 1.15;
}

.nav-logo-name {
  font-family: var(--font-head);
  font-size: 15px;
  font-weight: 800;
  letter-spacing: 0.05em;
  color: var(--white);
}

.nav-logo-sub {
  font-family: var(--font-mono);
  font-size: 9px;
  color: var(--muted);
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 2px;
  list-style: none;
  flex: 1;
}

.nav-links a {
  display: block;
  padding: 6px 14px;
  font-size: 13.5px;
  font-weight: 500;
  color: var(--muted);
  border-radius: 7px;
  transition: color 0.2s, background 0.2s;
}

.nav-links a:hover,
.nav-links a.active {
  color: var(--white);
  background: rgba(255,255,255,0.06);
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
}

.btn {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 13.5px;
  border-radius: 9px;
  padding: 9px 20px;
  transition: all 0.25s ease;
  letter-spacing: 0.01em;
}

.btn-ghost {
  border: 1px solid var(--border);
  color: var(--white);
  background: transparent;
}

.btn-ghost:hover {
  border-color: var(--border2);
  background: rgba(0,144,255,0.08);
  color: var(--blue2);
}

.btn-primary {
  background: linear-gradient(135deg, var(--blue) 0%, var(--blue2) 100%);
  color: #000;
  font-weight: 700;
  border: none;
  box-shadow: 0 0 24px rgba(0,144,255,0.3);
}

.btn-primary:hover {
  transform: translateY(-1px);
  box-shadow: 0 6px 32px rgba(0,144,255,0.45);
}

.btn-large {
  padding: 14px 30px;
  font-size: 15px;
  border-radius: 11px;
}

.btn-outline {
  border: 1px solid var(--border2);
  color: var(--blue2);
  background: rgba(0,144,255,0.06);
}

.btn-outline:hover {
  background: rgba(0,144,255,0.14);
  border-color: var(--blue);
}

.nav-hamburger {
  display: none;
  flex-direction: column;
  gap: 5px;
  padding: 6px;
  margin-left: auto;
  cursor: pointer;
}

.nav-hamburger span {
  display: block;
  width: 22px;
  height: 2px;
  background: var(--white);
  border-radius: 2px;
  transition: all 0.3s;
}

/* ============================================================
   HERO
   ============================================================ */
.hero {
  position: relative;
  min-height: 92vh;
  display: flex;
  align-items: center;
  overflow: hidden;
  padding: 80px 0;
}

/* Radial glow behind hero */
.hero::before {
  content: '';
  position: absolute;
  top: -200px;
  left: 50%;
  transform: translateX(-50%);
  width: 900px;
  height: 700px;
  background: radial-gradient(ellipse at center,
    rgba(0,144,255,0.12) 0%,
    rgba(0,200,255,0.06) 30%,
    transparent 70%);
  pointer-events: none;
}

.hero::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 180px;
  background: linear-gradient(to top, var(--black), transparent);
  pointer-events: none;
}

.hero-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(0,144,255,0.05) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,144,255,0.05) 1px, transparent 1px);
  background-size: 60px 60px;
  mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, black, transparent);
}

.container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 32px;
  position: relative;
  z-index: 2;
}

.hero-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: center;
}

.hero-tag {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 0.1em;
  color: var(--blue2);
  background: rgba(0,144,255,0.1);
  border: 1px solid rgba(0,144,255,0.25);
  border-radius: 100px;
  padding: 6px 14px;
  margin-bottom: 28px;
}

.hero-tag span { color: var(--green); font-size: 8px; }

.hero-title {
  font-family: var(--font-head);
  font-size: clamp(38px, 4.5vw, 62px);
  font-weight: 800;
  line-height: 1.05;
  letter-spacing: -0.02em;
  margin-bottom: 24px;
}

.hero-title .accent {
  background: linear-gradient(135deg, var(--blue), var(--cyan));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.hero-body {
  font-size: 16.5px;
  line-height: 1.65;
  color: var(--muted);
  max-width: 480px;
  margin-bottom: 40px;
}

.hero-cta {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-bottom: 52px;
}

.hero-stats {
  display: flex;
  gap: 32px;
  flex-wrap: wrap;
}

.hero-stat {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.hero-stat-num {
  font-family: var(--font-head);
  font-size: 26px;
  font-weight: 800;
  background: linear-gradient(135deg, var(--white), var(--muted));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.hero-stat-label {
  font-family: var(--font-mono);
  font-size: 10px;
  color: var(--muted);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

/* ============================================================
   TRADING TERMINAL (HERO RIGHT)
   ============================================================ */
.terminal {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 18px;
  overflow: hidden;
  box-shadow:
    0 0 0 1px rgba(0,144,255,0.06),
    0 40px 80px rgba(0,0,0,0.6),
    0 0 60px rgba(0,144,255,0.06);
  position: relative;
}

.terminal::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(0,144,255,0.5), transparent);
}

.terminal-top {
  background: rgba(255,255,255,0.02);
  border-bottom: 1px solid var(--border);
  padding: 14px 18px;
  display: flex;
  align-items: center;
  gap: 14px;
}

.t-dots {
  display: flex;
  gap: 6px;
}

.t-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
}

.t-dot:nth-child(1) { background: #ff5f57; }
.t-dot:nth-child(2) { background: #febc2e; }
.t-dot:nth-child(3) { background: #28c840; }

.t-tabs {
  display: flex;
  gap: 4px;
  flex: 1;
}

.t-tab {
  font-family: var(--font-mono);
  font-size: 11.5px;
  padding: 5px 12px;
  border-radius: 6px;
  color: var(--muted);
  cursor: pointer;
  transition: all 0.2s;
  border: 1px solid transparent;
}

.t-tab.active {
  background: rgba(0,144,255,0.15);
  border-color: rgba(0,144,255,0.3);
  color: var(--blue2);
}

.t-pair-info {
  font-family: var(--font-mono);
  font-size: 11px;
  display: flex;
  gap: 16px;
  margin-left: auto;
}

.t-pair-info .bid { color: var(--green); }
.t-pair-info .ask { color: var(--red); }

.chart-area {
  position: relative;
  height: 200px;
  background: rgba(0,0,0,0.25);
  overflow: hidden;
}

.chart-controls {
  display: flex;
  gap: 4px;
  padding: 8px 12px;
  position: absolute;
  top: 0;
  left: 0;
  z-index: 2;
}

.tf-btn {
  font-family: var(--font-mono);
  font-size: 10px;
  padding: 3px 8px;
  border-radius: 4px;
  color: var(--muted);
  cursor: pointer;
  background: rgba(255,255,255,0.04);
  border: 1px solid transparent;
  transition: all 0.2s;
}

.tf-btn.active {
  background: rgba(0,144,255,0.15);
  border-color: rgba(0,144,255,0.3);
  color: var(--blue2);
}

#heroChart {
  width: 100%;
  height: 100%;
  position: absolute;
  bottom: 0;
}

.terminal-body {
  display: grid;
  grid-template-columns: 1fr auto;
}

.order-panel {
  padding: 16px;
  border-right: 1px solid var(--border);
}

.order-type-row {
  display: flex;
  gap: 6px;
  margin-bottom: 14px;
}

.ot-btn {
  flex: 1;
  text-align: center;
  padding: 7px;
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 600;
  border-radius: 6px;
  cursor: pointer;
  background: rgba(255,255,255,0.04);
  color: var(--muted);
  border: 1px solid transparent;
  transition: all 0.2s;
}

.ot-btn.buy.active  { background: rgba(0,230,118,0.15); border-color: rgba(0,230,118,0.3); color: var(--green); }
.ot-btn.sell.active { background: rgba(255,61,90,0.15);  border-color: rgba(255,61,90,0.3);  color: var(--red); }
.ot-btn.lmt.active  { background: rgba(0,144,255,0.15); border-color: rgba(0,144,255,0.3); color: var(--blue2); }

.field {
  margin-bottom: 10px;
}

.field label {
  display: block;
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: 0.1em;
  color: var(--muted2);
  text-transform: uppercase;
  margin-bottom: 4px;
}

.field input {
  width: 100%;
  background: rgba(255,255,255,0.04);
  border: 1px solid var(--border);
  border-radius: 7px;
  padding: 8px 10px;
  color: var(--white);
  font-family: var(--font-mono);
  font-size: 12px;
  outline: none;
  transition: border-color 0.2s;
}

.field input:focus { border-color: var(--blue); }

.exec-btn {
  width: 100%;
  padding: 10px;
  border-radius: 8px;
  font-family: var(--font-body);
  font-size: 12.5px;
  font-weight: 700;
  margin-top: 10px;
  background: linear-gradient(135deg, #00b85e, #00e676);
  color: #000;
  transition: all 0.2s;
  box-shadow: 0 4px 16px rgba(0,230,118,0.2);
}

.exec-btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 8px 24px rgba(0,230,118,0.3);
}

.order-book {
  padding: 14px 16px;
  width: 140px;
}

.ob-title {
  font-family: var(--font-mono);
  font-size: 9px;
  color: var(--muted2);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 12px;
}

.ob-row {
  display: flex;
  justify-content: space-between;
  font-family: var(--font-mono);
  font-size: 10px;
  padding: 4px 0;
  border-bottom: 1px solid rgba(255,255,255,0.03);
}

.ob-row .ob-price.up { color: var(--green); }
.ob-row .ob-price.dn { color: var(--red); }
.ob-row .ob-vol { color: var(--muted); }

/* ============================================================
   FLOATING CARDS (hero decoration)
   ============================================================ */
.floating-chip {
  position: absolute;
  background: var(--card2);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 12px 16px;
  display: flex;
  align-items: center;
  gap: 10px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.4);
  backdrop-filter: blur(10px);
  animation: float 6s ease-in-out infinite;
  z-index: 5;
}

.floating-chip.chip1 {
  top: -30px;
  right: -20px;
  animation-delay: 0s;
}

.floating-chip.chip2 {
  bottom: -20px;
  left: -30px;
  animation-delay: -3s;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}

.chip-icon {
  width: 34px;
  height: 34px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 15px;
}

.chip-icon.green  { background: rgba(0,230,118,0.15); color: var(--green); }
.chip-icon.blue   { background: rgba(0,144,255,0.15); color: var(--blue2); }

.chip-label {
  font-family: var(--font-mono);
  font-size: 9px;
  color: var(--muted);
  letter-spacing: 0.05em;
  margin-bottom: 2px;
}

.chip-value {
  font-family: var(--font-head);
  font-size: 14px;
  font-weight: 700;
  color: var(--white);
}

/* ============================================================
   MARQUEE TRUST STRIP
   ============================================================ */
.trust-strip {
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  background: rgba(255,255,255,0.015);
  overflow: hidden;
  height: 48px;
  display: flex;
  align-items: center;
  position: relative;
  z-index: 2;
}

.trust-track {
  display: flex;
  gap: 0;
  animation: trust-scroll 22s linear infinite;
}

@keyframes trust-scroll {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}

.trust-item {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 0 40px;
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--muted2);
  letter-spacing: 0.06em;
  white-space: nowrap;
  border-right: 1px solid var(--border);
}

.trust-item i { color: var(--blue2); font-size: 12px; }

/* ============================================================
   SECTION SHARED
   ============================================================ */
.section { padding: 100px 0; position: relative; }

.section-tag {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 0.14em;
  color: var(--blue2);
  text-transform: uppercase;
  margin-bottom: 14px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.section-tag::before {
  content: '';
  width: 20px;
  height: 1px;
  background: var(--blue2);
}

.section-title {
  font-family: var(--font-head);
  font-size: clamp(28px, 3vw, 44px);
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -0.02em;
  margin-bottom: 16px;
}

.section-desc {
  font-size: 16px;
  line-height: 1.65;
  color: var(--muted);
  max-width: 580px;
}

.text-gradient {
  background: linear-gradient(135deg, var(--blue), var(--cyan));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* ============================================================
   MARKET OVERVIEW
   ============================================================ */
.market-section { background: var(--surface); }

.market-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.market-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 16px;
  overflow: hidden;
  transition: border-color 0.3s, box-shadow 0.3s;
}

.market-card:hover {
  border-color: var(--border2);
  box-shadow: 0 0 32px rgba(0,144,255,0.08);
}

.market-card-head {
  padding: 18px 20px 14px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--border);
}

.market-card-title {
  font-family: var(--font-head);
  font-size: 14px;
  font-weight: 700;
}

.live-badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: 0.08em;
  color: var(--green);
  background: rgba(0,230,118,0.1);
  border: 1px solid rgba(0,230,118,0.2);
  border-radius: 100px;
  padding: 3px 9px;
}

.live-dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--green);
  animation: blink 1.5s infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50%       { opacity: 0.3; }
}

.market-rows { padding: 8px 0; }

.mrow {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 80px;
  padding: 10px 20px;
  font-family: var(--font-mono);
  font-size: 11.5px;
  transition: background 0.15s;
  gap: 8px;
}

.mrow:hover { background: rgba(255,255,255,0.02); }

.mrow .sym { color: var(--muted); }
.mrow .bid { color: var(--white); }
.mrow .ask { color: var(--muted); }
.mrow .chg { text-align: right; font-weight: 600; }
.mrow .chg.up { color: var(--green); }
.mrow .chg.dn { color: var(--red); }

/* ============================================================
   FEATURES
   ============================================================ */
.features-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.feature-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 32px 28px;
  position: relative;
  overflow: hidden;
  transition: all 0.35s ease;
}

.feature-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--blue), transparent);
  opacity: 0;
  transition: opacity 0.35s;
}

.feature-card:hover {
  border-color: var(--border2);
  transform: translateY(-4px);
  box-shadow: 0 20px 50px rgba(0,0,0,0.3), 0 0 30px rgba(0,144,255,0.06);
}

.feature-card:hover::before { opacity: 1; }

.feature-icon {
  width: 52px;
  height: 52px;
  border-radius: 13px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  margin-bottom: 22px;
  background: rgba(0,144,255,0.1);
  color: var(--blue2);
  border: 1px solid rgba(0,144,255,0.15);
  transition: all 0.3s;
}

.feature-card:hover .feature-icon {
  background: rgba(0,144,255,0.18);
  box-shadow: 0 0 20px rgba(0,144,255,0.2);
}

.feature-title {
  font-family: var(--font-head);
  font-size: 17px;
  font-weight: 700;
  margin-bottom: 10px;
}

.feature-desc {
  font-size: 14px;
  line-height: 1.6;
  color: var(--muted);
}

/* ============================================================
   VISUAL STRIP (full-bleed imagery)
   ============================================================ */
.visual-strip {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 3px;
  height: 320px;
  overflow: hidden;
}

.vs-img {
  position: relative;
  overflow: hidden;
}

.vs-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
  filter: brightness(0.55) saturate(1.2);
}

.vs-img:hover img { transform: scale(1.06); filter: brightness(0.7) saturate(1.4); }

.vs-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20px;
  background: linear-gradient(to top, rgba(3,5,8,0.9), transparent);
}

.vs-label {
  font-family: var(--font-head);
  font-size: 14px;
  font-weight: 700;
  color: var(--white);
  margin-bottom: 3px;
}

.vs-sub {
  font-family: var(--font-mono);
  font-size: 10px;
  color: var(--muted);
}

/* ============================================================
   PLANS
   ============================================================ */
.plans-section { background: var(--surface); }

.plans-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}

.plan-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 28px 24px;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: all 0.3s ease;
}

.plan-card:hover {
  border-color: var(--border2);
  box-shadow: 0 20px 50px rgba(0,0,0,0.3);
  transform: translateY(-4px);
}

.plan-card.featured {
  background: linear-gradient(145deg, #0d1a2e, #0f1f38);
  border-color: rgba(0,144,255,0.4);
  box-shadow: 0 0 0 1px rgba(0,144,255,0.1), 0 30px 60px rgba(0,0,0,0.4), 0 0 40px rgba(0,144,255,0.08);
}

.plan-card.featured::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: linear-gradient(90deg, var(--blue), var(--cyan));
}

.plan-badge {
  position: absolute;
  top: 18px;
  right: 18px;
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: 0.08em;
  padding: 4px 10px;
  border-radius: 100px;
  font-weight: 600;
}

.plan-badge.popular { background: rgba(0,200,255,0.15); color: var(--blue2); border: 1px solid rgba(0,200,255,0.25); }
.plan-badge.hot     { background: rgba(0,144,255,0.2);  color: var(--blue);  border: 1px solid rgba(0,144,255,0.3); }
.plan-badge.vip     { background: rgba(255,192,64,0.15);  color: var(--gold);  border: 1px solid rgba(255,192,64,0.25); }

.plan-name {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 10px;
}

.plan-price {
  font-family: var(--font-head);
  font-size: 34px;
  font-weight: 800;
  letter-spacing: -0.02em;
  margin-bottom: 4px;
}

.plan-card.featured .plan-price {
  background: linear-gradient(135deg, var(--blue), var(--cyan));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.plan-sub {
  font-size: 12px;
  color: var(--muted);
  margin-bottom: 22px;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--border);
}

.plan-features {
  list-style: none;
  flex: 1;
  margin-bottom: 24px;
}

.plan-features li {
  display: flex;
  align-items: flex-start;
  gap: 9px;
  font-size: 13.5px;
  color: var(--muted);
  padding: 7px 0;
  border-bottom: 1px solid rgba(255,255,255,0.03);
  line-height: 1.4;
}

.plan-features li i {
  color: var(--green);
  font-size: 11px;
  margin-top: 2px;
  flex-shrink: 0;
}

.plan-btn {
  width: 100%;
  text-align: center;
  padding: 12px;
  border-radius: 10px;
  font-family: var(--font-body);
  font-size: 13.5px;
  font-weight: 700;
  transition: all 0.25s;
}

.plan-btn-outline {
  border: 1px solid var(--border);
  color: var(--muted);
}

.plan-btn-outline:hover {
  border-color: var(--border2);
  color: var(--blue2);
  background: rgba(0,144,255,0.06);
}

.plan-btn-solid {
  background: linear-gradient(135deg, var(--blue), var(--blue2));
  color: #000;
  box-shadow: 0 4px 20px rgba(0,144,255,0.3);
}

.plan-btn-solid:hover {
  transform: translateY(-1px);
  box-shadow: 0 8px 30px rgba(0,144,255,0.4);
}

/* ============================================================
   ABOUT / MISSION
   ============================================================ */
.about-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: start;
}

.about-image-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: auto auto;
  gap: 12px;
}

.ab-img {
  border-radius: 14px;
  overflow: hidden;
  position: relative;
}

.ab-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
  filter: brightness(0.75) saturate(1.1);
}

.ab-img:hover img { transform: scale(1.05); filter: brightness(0.85); }
.ab-img:nth-child(1) { height: 220px; }
.ab-img:nth-child(2) { height: 220px; margin-top: 40px; }
.ab-img:nth-child(3) { height: 160px; grid-column: 1 / 3; }

.about-values {
  margin-top: 32px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}

.about-val {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 13px;
  padding: 18px 16px;
  display: flex;
  gap: 12px;
  align-items: flex-start;
  transition: border-color 0.3s;
}

.about-val:hover { border-color: var(--border2); }

.about-val-icon {
  width: 36px;
  height: 36px;
  border-radius: 9px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  background: rgba(0,144,255,0.1);
  color: var(--blue2);
  flex-shrink: 0;
}

.about-val-title {
  font-family: var(--font-head);
  font-size: 13px;
  font-weight: 700;
  margin-bottom: 4px;
}

.about-val-text {
  font-size: 12px;
  line-height: 1.5;
  color: var(--muted);
}

.stat-row {
  display: flex;
  gap: 32px;
  margin-top: 36px;
}

.stat-box {
  display: flex;
  flex-direction: column;
}

.stat-box-num {
  font-family: var(--font-head);
  font-size: 30px;
  font-weight: 800;
  background: linear-gradient(135deg, var(--blue), var(--cyan));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.stat-box-label {
  font-family: var(--font-mono);
  font-size: 10px;
  color: var(--muted);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-top: 3px;
}

/* ============================================================
   FAQ
   ============================================================ */
.faq-section { background: var(--surface); }

.faq-layout {
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 80px;
  align-items: start;
}

.faq-list { display: flex; flex-direction: column; gap: 8px; }

.faq-item {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 13px;
  overflow: hidden;
  transition: border-color 0.25s;
}

.faq-item.open { border-color: rgba(0,144,255,0.3); }

.faq-q {
  padding: 18px 22px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
  gap: 16px;
  font-size: 14.5px;
  font-weight: 600;
  transition: color 0.2s;
}

.faq-item.open .faq-q { color: var(--blue2); }

.faq-toggle {
  width: 22px;
  height: 22px;
  border-radius: 6px;
  background: rgba(255,255,255,0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  flex-shrink: 0;
  transition: all 0.3s;
}

.faq-item.open .faq-toggle {
  background: rgba(0,144,255,0.15);
  color: var(--blue2);
  transform: rotate(45deg);
}

.faq-a {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.35s ease;
}

.faq-a-inner {
  padding: 0 22px 18px;
  font-size: 14px;
  line-height: 1.65;
  color: var(--muted);
}

.faq-item.open .faq-a { max-height: 300px; }

/* ============================================================
   TESTIMONIALS
   ============================================================ */
.testimonials-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.tcard {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 28px;
  position: relative;
  display: flex;
  flex-direction: column;
  transition: all 0.3s ease;
}

.tcard:hover {
  border-color: var(--border2);
  transform: translateY(-4px);
  box-shadow: 0 16px 40px rgba(0,0,0,0.3);
}

.tcard-stars {
  display: flex;
  gap: 3px;
  margin-bottom: 18px;
}

.tcard-stars i { color: var(--gold); font-size: 12px; }

.tcard-quote {
  font-family: var(--font-head);
  font-size: 80px;
  line-height: 0.8;
  color: var(--blue);
  opacity: 0.12;
  position: absolute;
  top: 18px;
  right: 22px;
  font-style: italic;
}

.tcard-text {
  font-size: 14.5px;
  line-height: 1.65;
  color: var(--muted);
  flex: 1;
  margin-bottom: 22px;
}

.tcard-author {
  display: flex;
  align-items: center;
  gap: 12px;
  border-top: 1px solid var(--border);
  padding-top: 18px;
}

.tcard-avatar {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid var(--border2);
}

.tcard-name {
  font-family: var(--font-head);
  font-size: 14px;
  font-weight: 700;
}

.tcard-role {
  font-family: var(--font-mono);
  font-size: 10px;
  color: var(--blue2);
}

/* ============================================================
   NEWS / BLOG
   ============================================================ */
.news-section { background: var(--surface); }

.news-controls {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
  margin-bottom: 36px;
}

.news-filter {
  font-family: var(--font-mono);
  font-size: 11px;
  padding: 7px 16px;
  border-radius: 100px;
  border: 1px solid var(--border);
  color: var(--muted);
  cursor: pointer;
  transition: all 0.2s;
  letter-spacing: 0.04em;
}

.news-filter:hover,
.news-filter.active {
  border-color: var(--border2);
  color: var(--blue2);
  background: rgba(0,144,255,0.08);
}

.news-refresh {
  margin-left: auto;
  font-family: var(--font-mono);
  font-size: 10px;
  color: var(--muted2);
  display: flex;
  align-items: center;
  gap: 6px;
}

.news-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.ncard {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 16px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: all 0.3s ease;
}

.ncard:hover {
  border-color: var(--border2);
  transform: translateY(-4px);
  box-shadow: 0 16px 40px rgba(0,0,0,0.3);
}

.ncard-img {
  height: 180px;
  overflow: hidden;
  position: relative;
}

.ncard-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
  filter: brightness(0.75) saturate(1.1);
}

.ncard:hover .ncard-img img { transform: scale(1.06); filter: brightness(0.85); }

.ncard-tag {
  position: absolute;
  top: 12px;
  left: 12px;
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: 0.08em;
  padding: 4px 10px;
  border-radius: 100px;
  font-weight: 600;
  background: rgba(0,144,255,0.85);
  color: var(--white);
}

.ncard-body {
  padding: 20px;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.ncard-meta {
  display: flex;
  gap: 14px;
  font-family: var(--font-mono);
  font-size: 10px;
  color: var(--muted2);
  margin-bottom: 10px;
}

.ncard-meta i { color: var(--blue2); }

.ncard-title {
  font-family: var(--font-head);
  font-size: 15px;
  font-weight: 700;
  line-height: 1.4;
  margin-bottom: 10px;
  flex: 1;
}

.ncard-excerpt {
  font-size: 13px;
  line-height: 1.55;
  color: var(--muted);
  margin-bottom: 16px;
}

.ncard-link {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--blue2);
  display: inline-flex;
  align-items: center;
  gap: 6px;
  letter-spacing: 0.04em;
  transition: gap 0.2s;
}

.ncard:hover .ncard-link { gap: 10px; }

/* ============================================================
   CONTACT
   ============================================================ */
.contact-layout {
  display: grid;
  grid-template-columns: 2fr 3fr;
  gap: 60px;
}

.contact-info-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 32px;
}

.cinfo-item {
  display: flex;
  gap: 14px;
  align-items: flex-start;
  padding: 18px 0;
  border-bottom: 1px solid var(--border);
}

.cinfo-item:last-child { border-bottom: none; }

.cinfo-icon {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  background: rgba(0,144,255,0.1);
  border: 1px solid rgba(0,144,255,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 15px;
  color: var(--blue2);
  flex-shrink: 0;
}

.cinfo-label {
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: 0.1em;
  color: var(--muted2);
  text-transform: uppercase;
  margin-bottom: 5px;
}

.cinfo-value {
  font-size: 13.5px;
  color: var(--white);
  line-height: 1.5;
}

.contact-form {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 36px;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

.form-field {
  margin-bottom: 18px;
}

.form-field label {
  display: block;
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 0.1em;
  color: var(--muted2);
  text-transform: uppercase;
  margin-bottom: 7px;
}

.form-field input,
.form-field textarea {
  width: 100%;
  background: rgba(255,255,255,0.04);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 12px 14px;
  color: var(--white);
  font-family: var(--font-body);
  font-size: 14px;
  outline: none;
  transition: border-color 0.2s, box-shadow 0.2s;
  resize: none;
}

.form-field input:focus,
.form-field textarea:focus {
  border-color: var(--blue);
  box-shadow: 0 0 0 3px rgba(0,144,255,0.1);
}

.form-field input::placeholder,
.form-field textarea::placeholder { color: var(--muted2); }

/* ============================================================
   CTA BANNER
   ============================================================ */
.cta-section {
  position: relative;
  padding: 100px 0;
  overflow: hidden;
  background: var(--surface);
}

.cta-section::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%,-50%);
  width: 800px;
  height: 400px;
  background: radial-gradient(ellipse at center, rgba(0,144,255,0.12) 0%, transparent 70%);
  pointer-events: none;
}

.cta-inner {
  text-align: center;
  position: relative;
  z-index: 2;
}

.cta-title {
  font-family: var(--font-head);
  font-size: clamp(32px, 4vw, 52px);
  font-weight: 800;
  letter-spacing: -0.02em;
  margin-bottom: 18px;
}

.cta-desc {
  font-size: 17px;
  color: var(--muted);
  margin-bottom: 40px;
}

.cta-btns {
  display: flex;
  gap: 14px;
  justify-content: center;
  flex-wrap: wrap;
}

/* ============================================================
   FOOTER
   ============================================================ */
footer {
  background: var(--surface);
  border-top: 1px solid var(--border);
  padding: 64px 0 32px;
}

.footer-top {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 2fr;
  gap: 48px;
  margin-bottom: 56px;
}

.footer-col-title {
  font-family: var(--font-head);
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.03em;
  margin-bottom: 18px;
  color: var(--white);
}

.footer-links {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.footer-links a {
  font-size: 13.5px;
  color: var(--muted);
  transition: color 0.2s;
}

.footer-links a:hover { color: var(--blue2); }

.footer-newsletter {
  display: flex;
  gap: 0;
}

.footer-newsletter input {
  flex: 1;
  background: rgba(255,255,255,0.05);
  border: 1px solid var(--border);
  border-right: none;
  border-radius: 9px 0 0 9px;
  padding: 11px 14px;
  color: var(--white);
  font-family: var(--font-body);
  font-size: 13px;
  outline: none;
  transition: border-color 0.2s;
}

.footer-newsletter input:focus { border-color: var(--blue); }

.footer-newsletter button {
  background: var(--blue);
  color: #000;
  font-family: var(--font-body);
  font-size: 13px;
  font-weight: 700;
  padding: 11px 20px;
  border-radius: 0 9px 9px 0;
  transition: background 0.2s;
}

.footer-newsletter button:hover { background: var(--blue2); }

.footer-socials {
  display: flex;
  gap: 10px;
  margin-top: 22px;
}

.social-btn {
  width: 36px;
  height: 36px;
  border-radius: 9px;
  border: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  color: var(--muted);
  transition: all 0.2s;
}

.social-btn:hover {
  border-color: var(--border2);
  color: var(--blue2);
  background: rgba(0,144,255,0.08);
}

.footer-bottom {
  border-top: 1px solid var(--border);
  padding-top: 28px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 16px;
