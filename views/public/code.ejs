<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Kortex Prime - Professional Trading Platform</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Advanced trading platform for Forex, Cryptocurrencies, Indices, and Commodities. Experience institutional-grade trading tools.">
<meta name="keywords" content="forex trading, crypto trading, trading platform, online trading, investment, Kortex Prime">

<!-- Fonts & Icons -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">

<!-- Bootstrap -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
:root {
    --kortex-primary: #0066FF;
    --kortex-secondary: #00D4FF;
    --kortex-accent: #7B3FE4;
    --kortex-dark: #0A0F2B;
    --kortex-darker: #070B1F;
    --kortex-card: #111837;
    --kortex-green: #00C853;
    --kortex-red: #FF3B30;
    --kortex-yellow: #FFCC00;
    --kortex-orange: #FF6B00;
}

* {
    color: #FFFFFF !important;
}

body {
    background: var(--kortex-dark);
    color: #FFFFFF !important;
    font-family: 'Inter', sans-serif;
    overflow-x: hidden;
    scroll-behavior: smooth;
}

/* Force white text on all elements */
h1, h2, h3, h4, h5, h6,
p, span, div, a:not(.btn),
li, td, th, small, strong,
label, .text-muted {
    color: #FFFFFF !important;
}

.text-muted {
    color: #B0B5C2 !important;
}

/* Trading Terminal Style Header - FIXED SIZE */
#trading-header {
    background: var(--kortex-darker);
    border-bottom: 1px solid rgba(255,255,255,0.05);
    padding: 6px 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    height: 36px;
    overflow: hidden;
}

.market-ticker {
    white-space: nowrap;
    overflow: hidden;
    height: 24px;
    display: flex;
    align-items: center;
}

.ticker-item {
    display: inline-block;
    padding: 0 15px;
    border-right: 1px solid rgba(255,255,255,0.1);
}

.ticker-item:last-child {
    border-right: none;
}

.ticker-item .price {
    color: #FFFFFF !important;
    font-weight: 600;
}

.ticker-item .change {
    font-weight: 600;
    margin-left: 5px;
}

.change.positive { color: var(--kortex-green) !important; }
.change.negative { color: var(--kortex-red) !important; }

/* Enhanced Navigation - MORE COMPACT */
.navbar {
    background: rgba(10, 15, 43, 0.98);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(0, 102, 255, 0.1);
    padding: 8px 0 !important;
    height: 70px;
}

.navbar-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 !important;
}

.navbar-brand img {
    height: 42px;
    width: auto;
}

.brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
}

.brand-text .main {
    font-size: 22px;
    font-weight: 800;
    background: linear-gradient(135deg, var(--kortex-primary), var(--kortex-secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.brand-text .tagline {
    font-size: 10px;
    color: #B0B5C2 !important;
    letter-spacing: 1px;
    text-transform: uppercase;
}

.nav-link {
    color: #FFFFFF !important;
    font-weight: 500;
    margin: 0 4px !important;
    padding: 6px 12px !important;
    border-radius: 6px;
    transition: all 0.3s ease;
    font-size: 14px;
}

.nav-link:hover {
    background: rgba(0, 102, 255, 0.1);
}

.nav-link.active {
    background: rgba(0, 102, 255, 0.15);
    color: var(--kortex-primary) !important;
}

/* Section Styling */
.section-padding {
    padding: 80px 0;
}

@media (max-width: 768px) {
    .section-padding {
        padding: 50px 0;
    }
}

.section-header {
    text-align: center;
    margin-bottom: 60px;
}

.section-subtitle {
    color: var(--kortex-primary) !important;
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 12px;
}

.section-title {
    font-size: 2.4rem;
    font-weight: 800;
    margin-bottom: 16px;
}

.section-description {
    font-size: 1rem;
    color: #B0B5C2 !important;
    max-width: 700px;
    margin: 0 auto;
}

/* Hero Section */
.hero {
    background: linear-gradient(135deg, rgba(10,15,43,0.95) 0%, rgba(7,11,31,0.98) 100%);
    min-height: 85vh;
    position: relative;
    overflow: hidden;
    padding-top: 120px !important;
}

.hero::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle at center, rgba(0,102,255,0.1) 0%, transparent 70%);
}

.hero-content {
    position: relative;
    z-index: 2;
}

.glow-text {
    background: linear-gradient(135deg, var(--kortex-primary), var(--kortex-secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

/* Advanced Trading Terminal */
.trading-terminal {
    background: var(--kortex-darker);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    overflow: hidden;
    height: 480px;
    position: relative;
}

.terminal-header {
    background: rgba(0,0,0,0.3);
    padding: 12px 15px;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    display: flex;
    align-items: center;
    gap: 12px;
}

.terminal-tabs {
    display: flex;
    gap: 4px;
}

.terminal-tab {
    background: rgba(255,255,255,0.05);
    padding: 6px 12px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 12px;
}

.terminal-tab.active {
    background: var(--kortex-primary);
}

.chart-container {
    height: 280px;
    background: rgba(0,0,0,0.2);
    position: relative;
}

.chart-controls {
    display: flex;
    gap: 8px;
    padding: 8px;
    background: rgba(0,0,0,0.2);
}

.timeframe-btn {
    padding: 4px 8px;
    background: rgba(255,255,255,0.05);
    border-radius: 4px;
    font-size: 11px;
    cursor: pointer;
}

.timeframe-btn.active {
    background: var(--kortex-primary);
}

.order-panel {
    background: rgba(0,0,0,0.2);
    padding: 15px;
    height: 100%;
}

.order-form {
    background: var(--kortex-card);
    padding: 15px;
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,0.05);
}

.order-type-selector {
    display: flex;
    gap: 8px;
    margin-bottom: 15px;
}

.order-type {
    flex: 1;
    text-align: center;
    padding: 8px;
    background: rgba(255,255,255,0.05);
    border-radius: 6px;
    cursor: pointer;
    font-size: 13px;
}

.order-type.active {
    background: var(--kortex-primary);
}

.input-group {
    margin-bottom: 12px;
}

.input-group label {
    display: block;
    margin-bottom: 4px;
    font-size: 11px;
    color: #B0B5C2 !important;
}

.input-group input {
    width: 100%;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 6px;
    padding: 8px;
    color: white !important;
    font-size: 13px;
}

/* Market Data Widgets */
.market-widget {
    background: var(--kortex-card);
    border-radius: 12px;
    padding: 20px;
    border: 1px solid rgba(255,255,255,0.05);
}

.widget-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    padding-bottom: 15px;
    border-bottom: 1px solid rgba(255,255,255,0.05);
}

.market-row {
    display: flex;
    justify-content: space-between;
    padding: 8px 0;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
}

.market-row:last-child {
    border-bottom: none;
}

.market-row .symbol {
    color: #B0B5C2 !important;
}

.market-row .bid {
    color: var(--kortex-green) !important;
}

.market-row .ask {
    color: var(--kortex-red) !important;
}

/* Trading Cards */
.trading-card {
    background: var(--kortex-card);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 16px;
    padding: 25px;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
    height: 100%;
}

.trading-card:hover {
    transform: translateY(-5px);
    border-color: rgba(0,102,255,0.3);
    box-shadow: 0 20px 40px rgba(0,102,255,0.15);
}

.card-icon {
    width: 60px;
    height: 60px;
    background: linear-gradient(135deg, var(--kortex-primary), var(--kortex-secondary));
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
}

.card-icon i {
    font-size: 24px;
    color: white !important;
}

/* Trading Plans */
.trading-plan-card {
    background: var(--kortex-card);
    border: 2px solid rgba(255,255,255,0.05);
    border-radius: 16px;
    padding: 30px;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
    height: 100%;
}

.trading-plan-card.featured {
    border-color: var(--kortex-primary);
    transform: scale(1.05);
    box-shadow: 0 25px 50px rgba(0,102,255,0.2);
}

.plan-badge {
    position: absolute;
    top: 15px;
    right: 15px;
    background: linear-gradient(135deg, var(--kortex-primary), var(--kortex-accent));
    color: white !important;
    padding: 6px 15px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 600;
}

.plan-price {
    font-size: 2.8rem;
    font-weight: 800;
    background: linear-gradient(135deg, var(--kortex-primary), var(--kortex-secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
}

.plan-feature {
    display: flex;
    align-items: center;
    margin-bottom: 12px;
    color: #B0B5C2 !important;
    font-size: 14px;
}

.plan-feature i {
    color: var(--kortex-green) !important;
    margin-right: 10px;
    font-size: 12px;
}

/* Trading Stats */
.stats-card {
    background: linear-gradient(135deg, var(--kortex-card), var(--kortex-darker));
    border-radius: 12px;
    padding: 20px;
    border: 1px solid rgba(0,102,255,0.1);
}

.stat-number {
    font-size: 2rem;
    font-weight: 800;
    background: linear-gradient(135deg, var(--kortex-primary), var(--kortex-secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

/* About Section */
.about-section {
    background: var(--kortex-darker);
}

.about-content {
    background: var(--kortex-card);
    border-radius: 20px;
    padding: 40px;
    border: 1px solid rgba(255,255,255,0.05);
}

.about-feature {
    display: flex;
    align-items: flex-start;
    margin-bottom: 25px;
}

.about-icon {
    width: 50px;
    height: 50px;
    background: linear-gradient(135deg, var(--kortex-primary), var(--kortex-accent));
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 15px;
    flex-shrink: 0;
}

.about-icon i {
    font-size: 20px;
    color: white !important;
}

/* FAQ Section */
.faq-section {
    background: var(--kortex-darker);
}

.faq-accordion .accordion-item {
    background: var(--kortex-card);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 10px;
    margin-bottom: 12px;
    overflow: hidden;
}

.faq-accordion .accordion-button {
    background: var(--kortex-card);
    color: white !important;
    font-weight: 600;
    padding: 18px;
    border: none;
    box-shadow: none;
    font-size: 15px;
}

.faq-accordion .accordion-button:not(.collapsed) {
    background: rgba(0,102,255,0.1);
    color: var(--kortex-primary) !important;
}

.faq-accordion .accordion-button::after {
    filter: brightness(0) invert(1);
}

.faq-accordion .accordion-body {
    background: rgba(0,0,0,0.2);
    color: #B0B5C2 !important;
    padding: 18px;
}

/* Testimonials Section */
.testimonial-card {
    background: var(--kortex-card);
    border-radius: 20px;
    padding: 30px;
    border: 1px solid rgba(255,255,255,0.05);
    position: relative;
    height: 100%;
}

.testimonial-card::before {
    content: '"';
    position: absolute;
    top: 15px;
    left: 25px;
    font-size: 60px;
    color: var(--kortex-primary);
    opacity: 0.2;
    font-family: serif;
}

.testimonial-text {
    font-size: 1rem;
    line-height: 1.6;
    color: #B0B5C2 !important;
    margin-bottom: 25px;
}

.testimonial-author {
    display: flex;
    align-items: center;
    gap: 12px;
}

.author-img {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    object-fit: cover;
}

/* Blog Section */
.blog-card {
    background: var(--kortex-card);
    border-radius: 20px;
    overflow: hidden;
    transition: all 0.3s ease;
    border: 1px solid rgba(255,255,255,0.05);
    height: 100%;
}

.blog-card:hover {
    transform: translateY(-5px);
    border-color: var(--kortex-primary);
}

.blog-img {
    width: 100%;
    height: 180px;
    object-fit: cover;
}

.blog-content {
    padding: 20px;
}

.blog-meta {
    display: flex;
    gap: 12px;
    margin-bottom: 12px;
    font-size: 0.85rem;
    color: #B0B5C2 !important;
}

.blog-meta span {
    display: flex;
    align-items: center;
    gap: 5px;
}

/* Contact Section */
.contact-section {
    background: var(--kortex-darker);
}

.contact-info {
    background: var(--kortex-card);
    border-radius: 20px;
    padding: 30px;
    height: 100%;
}

.contact-item {
    display: flex;
    align-items: flex-start;
    gap: 15px;
    margin-bottom: 25px;
}

.contact-icon {
    width: 45px;
    height: 45px;
    background: linear-gradient(135deg, var(--kortex-primary), var(--kortex-accent));
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.contact-icon i {
    font-size: 18px;
    color: white !important;
}

.contact-form {
    background: var(--kortex-card);
    border-radius: 20px;
    padding: 30px;
}

.form-control {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 10px;
    padding: 12px;
    color: white !important;
    width: 100%;
    margin-bottom: 15px;
    font-size: 14px;
}

.form-control:focus {
    outline: none;
    border-color: var(--kortex-primary);
    background: rgba(255,255,255,0.08);
    box-shadow: none;
}

/* Buttons */
.btn {
    font-size: 14px;
    font-weight: 600;
    padding: 10px 24px;
    border-radius: 8px;
    transition: all 0.3s ease;
}

.btn-primary {
    background: linear-gradient(135deg, var(--kortex-primary), var(--kortex-secondary)) !important;
    border: none !important;
    color: white !important;
}

.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(0,102,255,0.3);
}

.btn-outline-light {
    border: 2px solid rgba(255,255,255,0.2) !important;
    background: transparent !important;
    color: white !important;
}

.btn-outline-light:hover {
    border-color: var(--kortex-primary) !important;
    background: rgba(0,102,255,0.1) !important;
}

.btn-lg {
    padding: 14px 32px;
    font-size: 16px;
}

.btn-sm {
    padding: 8px 16px;
    font-size: 13px;
}

/* Footer */
.footer {
    background: var(--kortex-darker);
    border-top: 1px solid rgba(255,255,255,0.05);
}

.footer-links a {
    color: #B0B5C2 !important;
    text-decoration: none;
    transition: color 0.3s ease;
    font-size: 14px;
}

.footer-links a:hover {
    color: var(--kortex-primary) !important;
}

.legal-notice {
    background: rgba(255, 59, 48, 0.1);
    border: 1px solid rgba(255, 59, 48, 0.3);
    border-radius: 8px;
    padding: 12px;
    margin-top: 25px;
    color: #FFFFFF !important;
}

/* Animations */
@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.animate-on-scroll {
    opacity: 0;
    animation: fadeInUp 0.6s ease forwards;
}

/* Responsive */
@media (max-width: 992px) {
    .hero {
        min-height: auto;
        padding-top: 100px !important;
        padding-bottom: 50px !important;
    }
    
    .trading-terminal {
        height: 400px;
        margin-top: 30px;
    }
    
    .trading-plan-card.featured {
        transform: none;
    }
}

@media (max-width: 768px) {
    .navbar {
        padding: 10px 0 !important;
        height: auto;
        min-height: 70px;
    }
    
    .navbar-brand img {
        height: 36px;
    }
    
    .brand-text .main {
        font-size: 18px;
    }
    
    .nav-link {
        margin: 2px 0 !important;
        padding: 8px !important;
    }
    
    .display-3 {
        font-size: 2.2rem;
    }
    
    .section-title {
        font-size: 1.8rem;
    }
    
    .trading-terminal {
        height: auto;
    }
    
    .section-padding {
        padding: 40px 0;
    }
}

@media (max-width: 576px) {
    .hero {
        padding-top: 80px !important;
    }
    
    .navbar-collapse {
        background: rgba(10, 15, 43, 0.95);
        padding: 15px;
        border-radius: 10px;
        margin-top: 10px;
    }
    
    .btn-group {
        flex-direction: column;
        gap: 10px;
    }
    
    .btn-group .btn {
        width: 100%;
    }
}
</style>
