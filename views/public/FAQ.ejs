<style>
:root {
    --kortex-primary: #0066FF;
    --kortex-secondary: #00D4FF;
    --kortex-accent: #7B3FE4;
    --kortex-dark: #0A0F2B;
    --kortex-darker: #070B1F;
    --kortex-card: #111837;
    --kortex-green: #00C853;
    --kortex-red: #FF3B30;
    --kortex-yellow: #FFCC00;
    --kortex-orange: #FF6B00;
}

body {
    background: var(--kortex-dark);
    color: #FFFFFF !important;
    font-family: 'Inter', sans-serif;
    overflow-x: hidden;
}

/* Force white text on all elements */
h1, h2, h3, h4, h5, h6,
p, span, div, a:not(.btn),
li, td, th, small, strong {
    color: #FFFFFF !important;
}

/* Trading Terminal Style Header */
#trading-header {
    background: var(--kortex-darker);
    border-bottom: 1px solid rgba(255,255,255,0.05);
    padding: 8px 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
}

.market-ticker {
    white-space: nowrap;
    overflow: hidden;
}

.ticker-item {
    display: inline-block;
    padding: 0 20px;
    border-right: 1px solid rgba(255,255,255,0.1);
    color: #FFFFFF;
}

.ticker-item:last-child {
    border-right: none;
}

.ticker-item .price {
    color: #FFFFFF;
    font-weight: 600;
}

.ticker-item .change {
    font-weight: 600;
    margin-left: 5px;
}

.change.positive { color: var(--kortex-green) !important; }
.change.negative { color: var(--kortex-red) !important; }

/* Enhanced Navigation */
.navbar {
    background: rgba(10, 15, 43, 0.95);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(0, 102, 255, 0.1);
    padding: 15px 0;
}

.nav-link {
    color: #FFFFFF !important;
    font-weight: 500;
    margin: 0 8px;
    padding: 8px 16px !important;
    border-radius: 6px;
    transition: all 0.3s ease;
}

.nav-link:hover {
    background: rgba(0, 102, 255, 0.1);
}

.nav-link.active {
    background: rgba(0, 102, 255, 0.15);
}

/* FAQ Hero */
.faq-hero {
    background: linear-gradient(135deg, rgba(10,15,43,0.95) 0%, rgba(7,11,31,0.98) 100%);
    padding: 120px 0 60px;
    position: relative;
    overflow: hidden;
}

.faq-hero::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle at center, rgba(0,102,255,0.1) 0%, transparent 70%);
}

.glow-text {
    background: linear-gradient(135deg, var(--kortex-primary), var(--kortex-secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

/* FAQ Search */
.faq-search {
    max-width: 600px;
    margin: 0 auto;
    position: relative;
}

.faq-search input {
    width: 100%;
    background: var(--kortex-card);
    border: 2px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    padding: 18px 20px 18px 50px;
    color: white;
    font-size: 16px;
}

.faq-search i {
    position: absolute;
    left: 20px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--kortex-primary);
}

/* FAQ Categories */
.category-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    margin-bottom: 40px;
}

.category-tab {
    background: var(--kortex-card);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 10px;
    padding: 12px 24px;
    cursor: pointer;
    transition: all 0.3s ease;
}

.category-tab:hover {
    border-color: var(--kortex-primary);
    background: rgba(0,102,255,0.1);
}

.category-tab.active {
    background: var(--kortex-primary);
    border-color: var(--kortex-primary);
}

/* FAQ Accordion */
.faq-accordion {
    max-width: 900px;
    margin: 0 auto;
}

.faq-item {
    background: var(--kortex-card);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    margin-bottom: 15px;
    overflow: hidden;
}

.faq-question {
    padding: 24px 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    transition: all 0.3s ease;
}

.faq-question:hover {
    background: rgba(255,255,255,0.02);
}

.faq-question h5 {
    margin: 0;
    flex: 1;
}

.faq-icon {
    width: 30px;
    height: 30px;
    background: var(--kortex-primary);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
}

.faq-item.active .faq-icon {
    transform: rotate(180deg);
    background: var(--kortex-secondary);
}

.faq-answer {
    padding: 0 30px;
    max-height: 0;
    overflow: hidden;
    transition: all 0.3s ease;
}

.faq-item.active .faq-answer {
    padding: 0 30px 30px;
    max-height: 500px;
}

.faq-answer p {
    color: #B0B5C2 !important;
    margin-bottom: 15px;
}

.faq-answer ul {
    color: #B0B5C2 !important;
    padding-left: 20px;
    margin-bottom: 15px;
}

.faq-answer li {
    margin-bottom: 8px;
    color: #B0B5C2 !important;
}

/* Quick Links */
.quick-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
}

.quick-link-card {
    background: var(--kortex-card);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    padding: 25px;
    text-align: center;
    transition: all 0.3s ease;
}

.quick-link-card:hover {
    transform: translateY(-5px);
    border-color: var(--kortex-primary);
    box-shadow: 0 10px 30px rgba(0,102,255,0.2);
}

.quick-link-icon {
    width: 60px;
    height: 60px;
    background: linear-gradient(135deg, var(--kortex-primary), var(--kortex-secondary));
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
}

.quick-link-icon i {
    font-size: 24px;
    color: white;
}

/* Contact Card */
.contact-card {
    background: linear-gradient(135deg, var(--kortex-primary), var(--kortex-accent));
    border-radius: 16px;
    padding: 40px;
    text-align: center;
}

/* Buttons */
.btn-primary {
    background: linear-gradient(135deg, var(--kortex-primary), var(--kortex-secondary));
    border: none;
    padding: 12px 30px;
    border-radius: 10px;
    font-weight: 600;
    transition: all 0.3s ease;
    color: white !important;
}

.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(0,102,255,0.3);
}

.btn-outline-light {
    border: 2px solid rgba(255,255,255,0.2);
    background: transparent;
    color: white !important;
    padding: 12px 30px;
    border-radius: 10px;
    font-weight: 600;
    transition: all 0.3s ease;
}

.btn-outline-light:hover {
    border-color: var(--kortex-primary);
    background: rgba(0,102,255,0.1);
}

/* Footer */
.footer {
    background: var(--kortex-darker);
    border-top: 1px solid rgba(255,255,255,0.05);
}

.footer-links a {
    color: #B0B5C2 !important;
    text-decoration: none;
    transition: color 0.3s ease;
}

.footer-links a:hover {
    color: var(--kortex-primary) !important;
}

.legal-notice {
    background: rgba(255, 59, 48, 0.1);
    border: 1px solid rgba(255, 59, 48, 0.3);
    border-radius: 8px;
    padding: 15px;
    margin-top: 30px;
    color: #FFFFFF;
}

/* Animations */
@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.animate-in {
    animation: slideIn 0.5s ease forwards;
}

/* Responsive */
@media (max-width: 768px) {
    .display-3 {
        font-size: 2.5rem;
    }
    .faq-hero {
        padding: 80px 0 40px;
    }
    .category-tabs {
        gap: 8px;
    }
    .category-tab {
        padding: 10px 16px;
        font-size: 14px;
    }
    .faq-question {
        padding: 18px 20px;
    }
    .faq-answer {
        padding: 0 20px;
    }
    .faq-item.active .faq-answer {
        padding: 0 20px 20px;
    }
}
</style>
