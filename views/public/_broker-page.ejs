<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= page.title %> - Kortex Prime</title>
  <meta name="description" content="<%= page.summary %>">
  <link rel="icon" type="image/png" href="/img/favicon-32.png?v=20260509">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css">
  <link rel="stylesheet" href="/css/premium-ui.css">
  <style>
    :root {
      color-scheme: dark;
      --bg: #030712;
      --panel: rgba(15, 23, 42, 0.72);
      --line: rgba(148, 163, 184, 0.18);
      --text: #e5eefc;
      --muted: #93a4b8;
      --cyan: #08d5ff;
      --blue: #2477ff;
      --green: #22c55e;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      font-family: Inter, system-ui, sans-serif;
      background:
        radial-gradient(circle at 14% 8%, rgba(8, 213, 255, 0.13), transparent 30%),
        radial-gradient(circle at 86% 12%, rgba(34, 197, 94, 0.11), transparent 28%),
        linear-gradient(180deg, #020617 0%, #07111f 48%, #020617 100%);
      color: var(--text);
    }
    a { color: inherit; text-decoration: none; }
    .nav {
      position: sticky;
      top: 0;
      z-index: 30;
      border-bottom: 1px solid var(--line);
      background: rgba(2, 6, 23, 0.86);
      backdrop-filter: blur(18px);
    }
    .nav-inner {
      max-width: 1180px;
      margin: 0 auto;
      padding: 18px 22px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 22px;
    }
    .brand { display: flex; align-items: center; gap: 12px; font-weight: 800; letter-spacing: 0.03em; }
    .brand img { width: 44px; height: 44px; border-radius: 12px; }
    .brand small { display: block; margin-top: 2px; color: var(--muted); font-size: 11px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; }
    .links { display: flex; align-items: center; gap: 24px; color: var(--muted); font-weight: 700; }
    .links a.active, .links a:hover { color: #fff; }
    .actions { display: flex; align-items: center; gap: 12px; }
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      min-height: 44px;
      padding: 0 18px;
      border-radius: 12px;
      border: 1px solid var(--line);
      font-weight: 800;
    }
    .btn-primary { background: linear-gradient(135deg, var(--blue), var(--cyan)); color: #020617; border: 0; }
    .btn-ghost { background: rgba(15, 23, 42, 0.55); color: #fff; }
    .hero {
      max-width: 1180px;
      margin: 0 auto;
      padding: 88px 22px 54px;
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.9fr);
      gap: 48px;
      align-items: center;
    }
    .eyebrow { color: var(--cyan); font-weight: 800; letter-spacing: 0.22em; text-transform: uppercase; font-size: 13px; }
    h1 { margin: 18px 0 18px; font-size: clamp(42px, 6vw, 76px); line-height: 0.95; letter-spacing: -0.04em; }
    .lead { max-width: 720px; color: var(--muted); font-size: 19px; line-height: 1.75; }
    .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 34px; }
    .hero-points { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: 30px; }
    .hero-point { padding: 14px; border: 1px solid var(--line); border-radius: 14px; background: rgba(15, 23, 42, 0.58); }
    .hero-point strong { display: block; font-size: 18px; }
    .hero-point span { display: block; margin-top: 4px; color: var(--muted); font-size: 12px; line-height: 1.45; }
    .terminal {
      border: 1px solid var(--line);
      border-radius: 18px;
      background: linear-gradient(180deg, rgba(15, 23, 42, 0.9), rgba(2, 6, 23, 0.9));
      box-shadow: 0 24px 80px rgba(0,0,0,0.34);
      overflow: hidden;
    }
    .terminal-head { display: flex; align-items: center; justify-content: space-between; padding: 16px 18px; border-bottom: 1px solid var(--line); color: var(--muted); font-size: 13px; }
    .ticker { padding: 22px; display: grid; gap: 14px; }
    .row { display: grid; grid-template-columns: 1fr auto; gap: 12px; align-items: center; padding: 14px; border-radius: 12px; background: rgba(15, 23, 42, 0.72); border: 1px solid rgba(148,163,184,0.1); }
    .row strong { display: block; }
    .row span { color: var(--muted); font-size: 13px; }
    .gain { color: #4ade80; font-weight: 800; }
    .section { max-width: 1180px; margin: 0 auto; padding: 42px 22px; }
    .section-title { display: flex; justify-content: space-between; gap: 24px; align-items: end; margin-bottom: 24px; }
    .section-title h2 { margin: 0; font-size: clamp(28px, 4vw, 44px); letter-spacing: -0.03em; }
    .section-title p { max-width: 560px; margin: 0; color: var(--muted); line-height: 1.7; }
    .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
    .card {
      min-height: 230px;
      padding: 24px;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: var(--panel);
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.03);
    }
    .icon {
      width: 46px;
      height: 46px;
      display: grid;
      place-items: center;
      border-radius: 12px;
      color: var(--cyan);
      background: rgba(8, 213, 255, 0.1);
      margin-bottom: 18px;
    }
    .card h3 { margin: 0 0 10px; font-size: 20px; }
    .card p { margin: 0; color: var(--muted); line-height: 1.7; }
    .split {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 22px;
      align-items: stretch;
    }
    .panel {
      border: 1px solid var(--line);
      border-radius: 18px;
      background: rgba(15, 23, 42, 0.66);
      padding: 28px;
    }
    .panel h2 { margin: 0 0 12px; font-size: 34px; letter-spacing: -0.03em; }
    .panel p { margin: 0; color: var(--muted); line-height: 1.75; }
    .steps { display: grid; gap: 14px; }
    .step {
      display: grid;
      grid-template-columns: 44px 1fr;
      gap: 14px;
      padding: 18px;
      border: 1px solid rgba(148,163,184,0.14);
      border-radius: 15px;
      background: rgba(2, 6, 23, 0.34);
    }
    .step-num {
      width: 44px;
      height: 44px;
      display: grid;
      place-items: center;
      border-radius: 12px;
      background: rgba(8, 213, 255, 0.11);
      color: var(--cyan);
      font-weight: 900;
    }
    .step h3 { margin: 0 0 6px; font-size: 18px; }
    .step p { margin: 0; color: var(--muted); line-height: 1.65; }
    .wide-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
    .news-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
    .news-card {
      min-height: 260px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 22px;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: rgba(15, 23, 42, 0.68);
    }
    .news-meta { display: flex; justify-content: space-between; gap: 10px; color: var(--cyan); font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; }
    .news-card h3 { margin: 14px 0 10px; font-size: 20px; line-height: 1.35; }
    .news-card p { margin: 0; color: var(--muted); line-height: 1.7; }
    .news-card a { margin-top: 18px; color: var(--cyan); font-weight: 800; }
    .testimonials { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
    .quote-card {
      min-height: 300px;
      padding: 24px;
      border: 1px solid var(--line);
      border-radius: 18px;
      background: rgba(15, 23, 42, 0.7);
    }
    .quote-card .stars { color: #fbbf24; letter-spacing: 0.08em; }
    .quote-card blockquote { margin: 18px 0; color: #dbeafe; line-height: 1.75; }
    .quote-user { display: flex; align-items: center; gap: 12px; margin-top: 20px; }
    .avatar { width: 46px; height: 46px; display: grid; place-items: center; border-radius: 50%; background: linear-gradient(135deg, var(--blue), var(--cyan)); color: #020617; font-weight: 900; }
    .quote-user strong { display: block; }
    .quote-user span { display: block; color: var(--muted); font-size: 13px; margin-top: 3px; }
    .note {
      padding: 22px;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: rgba(2, 6, 23, 0.42);
    }
    .note strong { display: block; margin-bottom: 8px; font-size: 18px; }
    .note p { margin: 0; color: var(--muted); line-height: 1.7; }
    .band {
      max-width: 1180px;
      margin: 52px auto;
      padding: 34px;
      border-radius: 20px;
      border: 1px solid rgba(8, 213, 255, 0.22);
      background: linear-gradient(135deg, rgba(36,119,255,0.18), rgba(8,213,255,0.1));
      display: flex;
      justify-content: space-between;
      gap: 22px;
      align-items: center;
    }
    .band h2 { margin: 0 0 8px; font-size: 30px; }
    .band p { margin: 0; color: var(--muted); }
    footer { border-top: 1px solid var(--line); margin-top: 34px; }
    .footer-inner { max-width: 1180px; margin: 0 auto; padding: 28px 22px; color: var(--muted); display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
    @media (max-width: 920px) {
      .links { display: none; }
      .hero { grid-template-columns: 1fr; padding-top: 58px; }
      .hero-points { grid-template-columns: 1fr; }
      .grid { grid-template-columns: 1fr; }
      .split, .wide-grid, .news-grid, .testimonials { grid-template-columns: 1fr; }
      .band { margin-left: 22px; margin-right: 22px; flex-direction: column; align-items: flex-start; }
    }
    @media (max-width: 560px) {
      .actions .btn-ghost { display: none; }
      h1 { font-size: 42px; }
    }
  </style>
</head>
<body>
  <nav class="nav">
    <div class="nav-inner">
      <a href="/" class="brand">
        <img src="/img/logo.png?v=20260509" alt="Kortex Prime">
        <span>KORTEX PRIME<small>Professional Trading</small></span>
      </a>
      <div class="links">
        <a href="/">Home</a>
        <a href="/about" class="<%= page.slug === 'about' ? 'active' : '' %>">About</a>
        <a href="/feature" class="<%= page.slug === 'feature' ? 'active' : '' %>">Features</a>
        <a href="/offer" class="<%= page.slug === 'offer' ? 'active' : '' %>">Plans</a>
        <a href="/faq" class="<%= page.slug === 'faq' ? 'active' : '' %>">FAQ</a>
        <a href="/testimonial" class="<%= page.slug === 'testimonial' ? 'active' : '' %>">Testimonials</a>
        <a href="/blog" class="<%= page.slug === 'blog' ? 'active' : '' %>">News</a>
        <a href="/contact" class="<%= page.slug === 'contact' ? 'active' : '' %>">Contact</a>
      </div>
      <div class="actions">
        <a href="/login" class="btn btn-ghost"><i class="fas fa-arrow-right-to-bracket"></i> Login</a>
        <a href="/signup" class="btn btn-primary"><i class="fas fa-bolt"></i> Start Trading</a>
      </div>
    </div>
  </nav>

  <main>
    <section class="hero">
      <div>
        <div class="eyebrow"><%= page.kicker %></div>
        <h1><%= page.heading %></h1>
        <p class="lead"><%= page.summary %></p>
        <div class="hero-actions">
          <a href="<%= page.primaryHref || '/signup' %>" class="btn btn-primary"><i class="fas fa-bolt"></i> <%= page.primaryText || 'Open Account' %></a>
          <a href="<%= page.secondaryHref || '/contact' %>" class="btn btn-ghost"><i class="fas fa-headset"></i> <%= page.secondaryText || 'Talk to Support' %></a>
        </div>
        <div class="hero-points">
          <% (page.stats || []).forEach(stat => { %>
            <div class="hero-point">
              <strong><%= stat.value %></strong>
              <span><%= stat.label %></span>
            </div>
          <% }) %>
        </div>
      </div>
      <aside class="terminal">
        <div class="terminal-head">
          <span>Kortex Prime Market Desk</span>
          <strong>Live environment</strong>
        </div>
        <div class="ticker">
          <% (page.marketRows || []).forEach(row => { %>
            <div class="row">
              <div><strong><%= row.name %></strong><span><%= row.detail %></span></div>
              <div class="gain"><%= row.value %></div>
            </div>
          <% }) %>
        </div>
      </aside>
    </section>

    <section class="section">
      <div class="section-title">
        <h2><%= page.sectionTitle %></h2>
        <p><%= page.sectionIntro %></p>
      </div>
      <div class="grid">
        <% page.cards.forEach(card => { %>
          <article class="card">
            <div class="icon"><i class="<%= card.icon %>"></i></div>
            <h3><%= card.title %></h3>
            <p><%= card.body %></p>
          </article>
        <% }) %>
      </div>
    </section>

    <section class="section split">
      <div class="panel">
        <div class="eyebrow"><%= page.workflowKicker || 'Workflow' %></div>
        <h2><%= page.workflowTitle || 'A clearer way to manage a trading account' %></h2>
        <p><%= page.workflowIntro || 'Kortex Prime keeps each account action connected to the right record, notification, and dashboard view so traders can understand what is happening without chasing scattered information.' %></p>
      </div>
      <div class="steps">
        <% (page.steps || []).forEach((step, index) => { %>
          <article class="step">
            <div class="step-num"><%= index + 1 %></div>
            <div>
              <h3><%= step.title %></h3>
              <p><%= step.body %></p>
            </div>
          </article>
        <% }) %>
      </div>
    </section>

    <section class="section">
      <div class="section-title">
        <h2><%= page.proofTitle || 'Designed Like A Real Broker Workspace' %></h2>
        <p><%= page.proofIntro || 'The experience combines funding controls, trading records, admin review, and user-facing account clarity.' %></p>
      </div>
      <div class="wide-grid">
        <% (page.notes || []).forEach(note => { %>
          <article class="note">
            <strong><%= note.title %></strong>
            <p><%= note.body %></p>
          </article>
        <% }) %>
      </div>
    </section>

    <% if (page.news && page.news.items && page.news.items.length) { %>
      <section class="section">
        <div class="section-title">
          <h2>Live Crypto Headlines</h2>
          <p>Updated from public RSS feeds. Last refreshed: <%= page.news.updatedAt ? new Date(page.news.updatedAt).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' }) : 'recently' %>.</p>
        </div>
        <div class="news-grid">
          <% page.news.items.forEach(item => { %>
            <article class="news-card">
              <div>
                <div class="news-meta">
                  <span><%= item.source %></span>
                  <span><%= item.publishedAt ? new Date(item.publishedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : 'Latest' %></span>
                </div>
                <h3><%= item.title %></h3>
                <p><%= item.description || 'Read the full market update from the original source.' %></p>
              </div>
              <a href="<%= item.link %>" target="_blank" rel="noopener noreferrer">Read source <i class="fas fa-external-link-alt"></i></a>
            </article>
          <% }) %>
        </div>
      </section>
    <% } %>

    <% if (page.testimonials && page.testimonials.length) { %>
      <section class="section">
        <div class="section-title">
          <h2>Trader Testimonials</h2>
          <p>Feedback from different account types using Kortex Prime for funding, trading records, copy trading, verification, and support.</p>
        </div>
        <div class="testimonials">
          <% page.testimonials.forEach(testimony => { %>
            <article class="quote-card">
              <div class="stars">★★★★★</div>
              <blockquote>"<%= testimony.quote %>"</blockquote>
              <div class="quote-user">
                <div class="avatar"><%= testimony.name.slice(0, 1) %></div>
                <div>
                  <strong><%= testimony.name %></strong>
                  <span><%= testimony.role %> • <%= testimony.location %></span>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
      </section>
    <% } %>

    <section class="band">
      <div>
        <h2><%= page.ctaTitle %></h2>
        <p><%= page.ctaBody %></p>
      </div>
      <a href="<%= page.ctaHref || '/signup' %>" class="btn btn-primary"><%= page.ctaText || 'Create Account' %></a>
    </section>
  </main>

  <footer>
    <div class="footer-inner">
      <span>&copy; <%= new Date().getFullYear() %> Kortex Prime. All rights reserved.</span>
      <span>
        <a href="/terms">Terms</a> &nbsp; / &nbsp;
        <a href="/privacy-policy">Privacy</a> &nbsp; / &nbsp;
        <a href="/risk-disclosure">Risk Disclosure</a>
      </span>
    </div>
  </footer>
</body>
</html>
